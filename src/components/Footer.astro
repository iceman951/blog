---
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../consts';
import ConsentManager from './ConsentManager.astro';

const today = new Date();
---

<footer data-ui-language-region lang="en">
	<div class="inner">
		<div class="identity">
			<p class="wordmark">ICERUST</p>
			<p class="motto">
				<span data-ui-language-copy="en" lang="en">Built with curiosity.</span>
				<span data-ui-language-copy="th" lang="th">สร้างด้วยความอยากรู้</span>
			</p>
		</div>

		<nav
			class="utility-links"
			aria-label="Privacy and contact"
			data-ui-en-aria-label="Privacy and contact"
			data-ui-th-aria-label="ความเป็นส่วนตัวและช่องทางติดต่อ"
		>
			<a href="/privacy/">
				<span data-ui-language-copy="en" lang="en">Privacy</span>
				<span data-ui-language-copy="th" lang="th">ความเป็นส่วนตัว</span>
			</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>
				<span data-ui-language-copy="en" lang="en">Email</span>
				<span data-ui-language-copy="th" lang="th">อีเมล</span>
			</a>
			<a href={SOCIAL_LINKS.github} target="_blank" rel="me noopener noreferrer">GitHub</a>
			<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
			<a href={SOCIAL_LINKS.medium} target="_blank" rel="me noopener noreferrer">Medium</a>
			<a href="/rss.xml">RSS</a>
			<button type="button" data-open-consent-settings>
				<span data-ui-language-copy="en" lang="en">Cookie settings</span>
				<span data-ui-language-copy="th" lang="th">ตั้งค่าคุกกี้</span>
			</button>
		</nav>

		<p class="copyright">&copy; {today.getFullYear()} Vorrapong Kertnat</p>
	</div>
</footer>
<ConsentManager />

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-open-consent-settings]').forEach((button) => {
		button.addEventListener('click', () => {
			window.dispatchEvent(new CustomEvent('icerust:consent-open'));
		});
	});
</script>

<style>
	footer {
		margin-top: var(--space-16);
		border-top: 1px solid var(--border);
	}
	.inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-8);
		width: var(--frame);
		max-width: calc(100% - 2 * var(--gutter));
		margin: 0 auto;
		padding: var(--space-8) 0 var(--space-12);
	}
	.wordmark {
		margin: 0;
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.motto,
	.copyright {
		margin: var(--space-1) 0 0;
		color: var(--text-faint);
		font-size: 0.8rem;
	}
	.utility-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-6);
		max-width: 30rem;
		font-size: 0.85rem;
	}
	.utility-links a,
	.utility-links button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text-muted);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
		transition: color var(--duration) var(--ease);
	}
	.utility-links a:hover,
	.utility-links button:hover {
		color: var(--accent);
	}
	.copyright {
		margin-top: 0;
		line-height: 44px;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 860px) {
		.inner {
			flex-direction: column;
			gap: var(--space-4);
			padding: var(--space-8) 0;
		}
	}
</style>
