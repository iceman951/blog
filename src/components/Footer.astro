---
import { CONTACT_EMAIL } from '../consts';
import ConsentManager from './ConsentManager.astro';
import HankoMark from './HankoMark.astro';

const today = new Date();
---

<footer data-ui-language-region lang="en">
	<div class="inner">
		<div class="identity">
			<p class="wordmark">ICERUST <span class="sep" aria-hidden="true">|</span> <span lang="ja">氷錆</span></p>
			<p class="motto">
				<span data-ui-language-copy="en" lang="en">Built with curiosity.</span>
				<span data-ui-language-copy="th" lang="th">สร้างด้วยความอยากรู้</span>
			</p>
		</div>

		<nav
			class="utility-links"
			aria-label="Privacy and contact"
			data-ui-en-aria-label="Privacy and contact"
			data-ui-th-aria-label="ความเป็นส่วนตัวและช่องทางติดต่อ"
		>
			<a href="/privacy/">
				<span data-ui-language-copy="en" lang="en">Privacy</span>
				<span data-ui-language-copy="th" lang="th">ความเป็นส่วนตัว</span>
			</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>
				<span data-ui-language-copy="en" lang="en">Email</span>
				<span data-ui-language-copy="th" lang="th">อีเมล</span>
			</a>
			<a href="https://github.com/iceman951" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://www.linkedin.com/in/vorrapong/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="https://medium.com/@iceman951" target="_blank" rel="noopener noreferrer">Medium</a>
			<button type="button" data-open-consent-settings>
				<span data-ui-language-copy="en" lang="en">Cookie settings</span>
				<span data-ui-language-copy="th" lang="th">ตั้งค่าคุกกี้</span>
			</button>
		</nav>

		<div class="seal">
			<HankoMark size="sm" />
			<p class="copyright">&copy; {today.getFullYear()} Vorrapong Kertnat</p>
		</div>
	</div>
</footer>
<ConsentManager />

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-open-consent-settings]').forEach((button) => {
		button.addEventListener('click', () => {
			window.dispatchEvent(new CustomEvent('icerust:consent-open'));
		});
	});
</script>

<style>
	footer {
		margin-top: var(--space-24);
		border-top: 1px solid var(--line-light);
		font-family: var(--stack-meta);
	}
	.inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-8);
		width: var(--frame);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: var(--space-12) 0 var(--space-16);
	}
	.wordmark {
		margin: 0;
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 0.92rem;
		letter-spacing: 0.18em;
	}
	.sep {
		color: var(--line);
	}
	.motto,
	.copyright {
		margin: var(--space-2) 0 0;
		color: var(--ink-muted);
		font-size: 0.76rem;
	}
	.utility-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		max-width: 28rem;
		font-size: 0.76rem;
	}
	.utility-links a,
	.utility-links button {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
		transition: color var(--duration) var(--ease);
	}
	.utility-links a:hover,
	.utility-links button:hover {
		color: var(--vermilion);
	}
	.seal {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-2);
		text-align: right;
	}

	@media (max-width: 860px) {
		.inner {
			flex-wrap: wrap;
			gap: var(--space-8);
			max-width: calc(100% - 2rem);
			padding: var(--space-8) 0 var(--space-12);
		}
		.seal {
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
