---
/**
 * A single ink plum branch entering from one corner. One per page, decorative.
 */
interface Props {
	corner?: 'top-right' | 'bottom-left';
	class?: string;
}
const { corner = 'top-right', class: className } = Astro.props;
---

<svg
	class:list={['ink-decoration', corner, className]}
	viewBox="0 0 260 200"
	role="presentation"
	aria-hidden="true"
	focusable="false"
>
	<g fill="none" stroke="#1e1c19" stroke-linecap="round">
		<path d="M256 8 C214 34 176 62 138 96 C112 120 84 140 44 156" stroke-width="4.5"></path>
		<path d="M200 44 C186 66 172 80 148 92" stroke-width="2.2"></path>
		<path d="M132 102 C120 124 106 136 84 146" stroke-width="2"></path>
		<path d="M170 70 C176 92 178 108 174 126" stroke-width="1.6"></path>
	</g>
	<g fill="#1e1c19" fill-opacity="0.5">
		<circle cx="146" cy="92" r="6"></circle>
		<circle cx="158" cy="82" r="4.5"></circle>
		<circle cx="136" cy="82" r="4"></circle>
		<circle cx="84" cy="146" r="5.5"></circle>
		<circle cx="74" cy="136" r="4"></circle>
		<circle cx="174" cy="126" r="4.5"></circle>
		<circle cx="212" cy="36" r="5"></circle>
		<circle cx="222" cy="46" r="3.5"></circle>
	</g>
</svg>

<style>
	svg {
		position: absolute;
		width: clamp(150px, 18vw, 250px);
		height: auto;
		opacity: 0.12;
		pointer-events: none;
	}
	.top-right {
		top: 0;
		right: 0;
	}
	.bottom-left {
		bottom: 0;
		left: 0;
		transform: scaleX(-1);
	}
	@media (max-width: 860px) {
		svg {
			display: none;
		}
	}
</style>
