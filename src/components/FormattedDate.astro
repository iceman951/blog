---
import { dateLocale, type UiLanguage } from '../i18n';

interface Props {
	date: Date;
	lang?: UiLanguage;
}

const { date, lang = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(dateLocale(lang), {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
