---
import { editorialDate } from '../lib/dates';
import { dateLocale, type UiLanguage } from '../i18n';

interface Props {
	date: Date;
	lang?: UiLanguage;
	/** `editorial` prints "23 AUG 2026"; the default keeps the locale's own form. */
	variant?: 'default' | 'editorial';
}

const { date, lang = 'en', variant = 'default' } = Astro.props;

const editorial = editorialDate(date);
---

<time datetime={date.toISOString()}>
	{
		variant === 'editorial'
			? editorial
			: date.toLocaleDateString(dateLocale(lang), {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
				})
	}
</time>
