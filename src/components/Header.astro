---
import HankoMark from './HankoMark.astro';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
---

<header data-ui-language-region lang="en">
	<div class="bar">
		<a class="brand" href="/">
			<span class="wordmark">ICERUST</span>
			<span class="mark" lang="ja">氷錆</span>
			<span class="tagline">
				<span data-ui-language-copy="en" lang="en">Thoughts on software,<br />systems, and experiments.</span>
				<span data-ui-language-copy="th" lang="th">บันทึกเรื่องซอฟต์แวร์<br />ระบบ และการทดลอง</span>
			</span>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="primary-navigation"
			aria-label="Open menu"
			data-ui-en-aria-label="Open menu"
			data-ui-th-aria-label="เปิดเมนู"
		>
			<span class="bars" aria-hidden="true"></span>
		</button>

		<nav
			id="primary-navigation"
			aria-label="Primary navigation"
			data-ui-en-aria-label="Primary navigation"
			data-ui-th-aria-label="เมนูนำทางหลัก"
		>
			<HeaderLink href="/">
				<span data-ui-language-copy="en" lang="en">Home</span>
				<span data-ui-language-copy="th" lang="th">หน้าหลัก</span>
			</HeaderLink>
			<HeaderLink href="/blog">
				<span data-ui-language-copy="en" lang="en">Blog</span>
				<span data-ui-language-copy="th" lang="th">บล็อก</span>
			</HeaderLink>
			<HeaderLink href="/about">
				<span data-ui-language-copy="en" lang="en">About</span>
				<span data-ui-language-copy="th" lang="th">เกี่ยวกับ</span>
			</HeaderLink>

			<LanguageSwitcher />

			<a
				class="seal-link"
				href="https://github.com/iceman951"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="ICE on GitHub"
				data-ui-en-aria-label="ICE on GitHub"
				data-ui-th-aria-label="ICE บน GitHub"
			>
				<HankoMark size="sm" />
			</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const header = document.querySelector<HTMLElement>('header');
	toggle?.addEventListener('click', () => {
		const open = header?.toggleAttribute('data-menu-open');
		toggle.setAttribute('aria-expanded', String(Boolean(open)));
	});
</script>

<style>
	header {
		border-bottom: 1px solid var(--line-light);
	}
	.bar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-8);
		width: var(--frame);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: var(--space-6) 0;
	}
	.brand {
		display: block;
		color: var(--ink);
		text-decoration: none;
	}
	.wordmark {
		display: block;
		font-family: var(--stack-display);
		font-size: 1.28rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		line-height: 1.1;
	}
	.mark {
		display: block;
		margin-top: 0.15em;
		color: var(--ink-muted);
		font-family: var(--stack-display);
		font-size: 0.92rem;
		letter-spacing: 0.3em;
		line-height: 1.2;
	}
	.tagline {
		display: block;
		margin-top: var(--space-2);
		color: var(--ink-muted);
		font-family: var(--stack-meta);
		font-size: 0.68rem;
		line-height: 1.5;
	}
	nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		padding-top: 0.35rem;
	}
	.seal-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		text-decoration: none;
		opacity: 0.85;
		transition: opacity var(--duration) var(--ease);
	}
	.seal-link:hover {
		opacity: 1;
	}
	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}
	.bars,
	.bars::before,
	.bars::after {
		display: block;
		width: 20px;
		height: 1.5px;
		background: currentColor;
	}
	.bars {
		margin: 0 auto;
		position: relative;
	}
	.bars::before,
	.bars::after {
		position: absolute;
		content: '';
	}
	.bars::before {
		top: -6px;
	}
	.bars::after {
		top: 6px;
	}

	@media (max-width: 860px) {
		.bar {
			flex-wrap: wrap;
			max-width: calc(100% - 2rem);
			padding: var(--space-4) 0;
		}
		.menu-toggle {
			display: block;
		}
		nav {
			display: none;
			flex-basis: 100%;
			flex-wrap: wrap;
			gap: var(--space-4) var(--space-6);
			margin-top: var(--space-4);
			padding-top: var(--space-4);
			border-top: 1px solid var(--line-light);
		}
		header[data-menu-open] nav {
			display: flex;
		}
		.tagline {
			display: none;
		}
	}
</style>
