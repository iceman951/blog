---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
---

<header data-ui-language-region lang="en">
	<nav
		aria-label="Primary navigation"
		data-ui-en-aria-label="Primary navigation"
		data-ui-th-aria-label="เมนูนำทางหลัก"
	>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">
				<span data-ui-language-copy="en" lang="en">Home</span>
				<span data-ui-language-copy="th" lang="th">หน้าหลัก</span>
			</HeaderLink>
			<HeaderLink href="/blog">
				<span data-ui-language-copy="en" lang="en">Blog</span>
				<span data-ui-language-copy="th" lang="th">บล็อก</span>
			</HeaderLink>
			<HeaderLink href="/about">
				<span data-ui-language-copy="en" lang="en">About</span>
				<span data-ui-language-copy="th" lang="th">เกี่ยวกับ</span>
			</HeaderLink>
		</div>
		<div class="header-tools">
			<div class="social-links">
				<a
					href="https://github.com/iceman951"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="ICE on GitHub"
					data-ui-en-aria-label="ICE on GitHub"
					data-ui-th-aria-label="ICE บน GitHub"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path></svg
					>
				</a>
				<a
					href="https://www.linkedin.com/in/vorrapong/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="ICE on LinkedIn"
					data-ui-en-aria-label="ICE on LinkedIn"
					data-ui-th-aria-label="ICE บน LinkedIn"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path></svg
					>
				</a>
				<a
					href="https://medium.com/@iceman951"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="ICE on Medium"
					data-ui-en-aria-label="ICE on Medium"
					data-ui-th-aria-label="ICE บน Medium"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M4.21 0A4.201 4.201 0 0 0 0 4.21v15.58A4.201 4.201 0 0 0 4.21 24h15.58A4.201 4.201 0 0 0 24 19.79v-1.093c-.137.013-.278.02-.422.02-2.577 0-4.027-2.146-4.09-4.832a7.592 7.592 0 0 1 .022-.708c.093-1.186.475-2.241 1.105-3.022a3.885 3.885 0 0 1 1.395-1.1c.468-.237 1.127-.367 1.664-.367h.023c.101 0 .202.004.303.01V4.211A4.201 4.201 0 0 0 19.79 0Zm.198 5.583h4.165l3.588 8.435 3.59-8.435h3.864v.146l-.019.004c-.705.16-1.063.397-1.063 1.254h-.003l.003 10.274c.06.676.424.885 1.063 1.03l.02.004v.145h-4.923v-.145l.019-.005c.639-.144.994-.353 1.054-1.03V7.267l-4.745 11.15h-.261L6.15 7.569v9.445c0 .857.358 1.094 1.063 1.253l.02.004v.147H4.405v-.147l.019-.004c.705-.16 1.065-.397 1.065-1.253V6.987c0-.857-.358-1.094-1.064-1.254l-.018-.004z"
						></path></svg
					>
				</a>
			</div>
			<LanguageSwitcher />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--cream));
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-family: var(--font-sans), var(--font-thai), system-ui, sans-serif;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		justify-content: center;
	}
	.header-tools {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 0.65rem;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 840px) {
		header {
			padding: 0 0.75rem;
		}
		nav {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0;
		}
		h2 {
			grid-column: 1;
			grid-row: 1;
		}
		h2 a {
			display: inline-flex;
			min-height: 44px;
			align-items: center;
			padding-inline: 0;
		}
		.header-tools {
			grid-column: 2;
			grid-row: 1;
		}
		.internal-links {
			grid-column: 1 / -1;
			grid-row: 2;
			border-top: 1px solid rgb(var(--gray-light));
		}
		.internal-links :global(a) {
			min-height: 44px;
			padding-block: 0.65rem;
		}
		.social-links {
			display: none;
		}
	}
	@media (max-width: 360px) {
		h2 {
			font-size: 0.82em;
		}
	}
</style>
