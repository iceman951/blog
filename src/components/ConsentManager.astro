<!--
  Browser integration contract:
  - Listen for `icerust:consent-change` on `window`.
    Event detail is `{ analytics: boolean }` and is emitted on initialization
    and whenever the visitor saves a choice.
  - Reopen this panel with
    `window.dispatchEvent(new CustomEvent('icerust:consent-open'))`.
  - Late consumers can read `window.icerustConsent.get()` or call
    `window.icerustConsent.open()`.
-->

<div class="consent-manager" data-consent-manager data-ui-language-region lang="en">
	<section
		class="consent-banner"
		data-consent-banner
		aria-labelledby="consent-banner-title"
		aria-describedby="consent-banner-description-en"
		data-ui-en-aria-describedby="consent-banner-description-en"
		data-ui-th-aria-describedby="consent-banner-description-th"
		hidden
	>
		<div class="consent-copy">
			<h2 id="consent-banner-title">
				<span data-ui-language-copy="en" lang="en">Your privacy</span>
				<span data-ui-language-copy="th" lang="th">ความเป็นส่วนตัวของคุณ</span>
			</h2>
			<p id="consent-banner-description-en" data-ui-language-copy="en" lang="en">
				This site uses necessary storage to remember your choice. Google Analytics only
				loads after you consent.
			</p>
			<p
				id="consent-banner-description-th"
				data-ui-language-copy="th"
				lang="th"
			>
				เว็บไซต์นี้ใช้พื้นที่จัดเก็บที่จำเป็นเพื่อจดจำตัวเลือกของคุณ และจะเปิด Google
				Analytics เฉพาะเมื่อคุณยินยอมเท่านั้น
			</p>
			<a href="/privacy/">
				<span data-ui-language-copy="en" lang="en">Read the Privacy Policy</span>
				<span data-ui-language-copy="th" lang="th">อ่านนโยบายความเป็นส่วนตัว</span>
			</a>
		</div>

		<div
			class="consent-actions"
			aria-label="Privacy choices"
			data-ui-en-aria-label="Privacy choices"
			data-ui-th-aria-label="ตัวเลือกความเป็นส่วนตัว"
		>
			<button class="primary" type="button" data-consent-accept>
				<span data-ui-language-copy="en" lang="en">Accept all</span>
				<span data-ui-language-copy="th" lang="th">ยอมรับทั้งหมด</span>
			</button>
			<button type="button" data-consent-reject>
				<span data-ui-language-copy="en" lang="en">Reject non-essential</span>
				<span data-ui-language-copy="th" lang="th">ปฏิเสธที่ไม่จำเป็น</span>
			</button>
			<button class="text-button" type="button" data-consent-settings>
				<span data-ui-language-copy="en" lang="en">Settings</span>
				<span data-ui-language-copy="th" lang="th">ตั้งค่า</span>
			</button>
		</div>
	</section>

	<dialog
		class="consent-dialog"
		data-consent-dialog
		aria-labelledby="consent-dialog-title"
		aria-describedby="consent-dialog-description-en"
		data-ui-en-aria-describedby="consent-dialog-description-en"
		data-ui-th-aria-describedby="consent-dialog-description-th"
	>
		<form class="consent-dialog-content" data-consent-form>
			<div class="dialog-heading">
				<div>
					<p class="eyebrow">
						<span data-ui-language-copy="en" lang="en">Privacy controls</span>
						<span data-ui-language-copy="th" lang="th"
							>การควบคุมความเป็นส่วนตัว</span
						>
					</p>
					<h2 id="consent-dialog-title">
						<span data-ui-language-copy="en" lang="en">Privacy settings</span>
						<span data-ui-language-copy="th" lang="th">ตั้งค่าความเป็นส่วนตัว</span>
					</h2>
				</div>
				<button
					class="close-button"
					type="button"
					data-consent-close
					aria-label="Close privacy settings"
					data-ui-en-aria-label="Close privacy settings"
					data-ui-th-aria-label="ปิดหน้าต่างตั้งค่า"
				>
					<span aria-hidden="true">×</span>
				</button>
			</div>

			<p
				id="consent-dialog-description-en"
				class="dialog-description"
				data-ui-language-copy="en"
				lang="en"
			>
				You can choose what this site may use and change your choice at any time.
			</p>
			<p
				id="consent-dialog-description-th"
				class="dialog-description"
				data-ui-language-copy="th"
				lang="th"
			>
				เลือกข้อมูลที่อนุญาตให้เว็บไซต์ใช้ได้ คุณเปลี่ยนใจภายหลังได้เสมอ
			</p>

			<div class="consent-options">
				<div class="consent-option">
					<div>
						<h3>
							<span data-ui-language-copy="en" lang="en">Necessary</span>
							<span data-ui-language-copy="th" lang="th">จำเป็น</span>
						</h3>
						<p id="necessary-description-en" data-ui-language-copy="en" lang="en">
							Remembers this privacy choice and cannot be disabled.
						</p>
						<p
							id="necessary-description-th"
							data-ui-language-copy="th"
							lang="th"
						>
							ใช้เพื่อจดจำตัวเลือกความเป็นส่วนตัวนี้ ปิดไม่ได้
						</p>
					</div>
					<label class="switch">
						<input
							type="checkbox"
							checked
							disabled
							aria-label="Necessary storage is always active"
							data-ui-en-aria-label="Necessary storage is always active"
							data-ui-th-aria-label="พื้นที่จัดเก็บที่จำเป็นเปิดใช้งานอยู่เสมอ"
							aria-describedby="necessary-description-en"
							data-ui-en-aria-describedby="necessary-description-en"
							data-ui-th-aria-describedby="necessary-description-th"
						/>
						<span class="switch-track" aria-hidden="true"></span>
					</label>
				</div>

				<div class="consent-option">
					<div>
						<h3>
							<span data-ui-language-copy="en" lang="en">Analytics</span>
							<span data-ui-language-copy="th" lang="th">การวิเคราะห์</span>
						</h3>
						<p id="analytics-description-en" data-ui-language-copy="en" lang="en">
							Helps understand site usage through Google Analytics.
						</p>
						<p
							id="analytics-description-th"
							data-ui-language-copy="th"
							lang="th"
						>
							ช่วยให้เข้าใจการใช้งานเว็บไซต์ผ่าน Google Analytics
						</p>
					</div>
					<label class="switch">
						<input
							type="checkbox"
							data-consent-analytics
							aria-label="Allow Analytics"
							data-ui-en-aria-label="Allow Analytics"
							data-ui-th-aria-label="อนุญาต Analytics"
							aria-describedby="analytics-description-en"
							data-ui-en-aria-describedby="analytics-description-en"
							data-ui-th-aria-describedby="analytics-description-th"
						/>
						<span class="switch-track" aria-hidden="true"></span>
					</label>
				</div>
			</div>

			<div class="dialog-actions">
				<button type="button" data-dialog-reject>
					<span data-ui-language-copy="en" lang="en">Reject non-essential</span>
					<span data-ui-language-copy="th" lang="th">ปฏิเสธที่ไม่จำเป็น</span>
				</button>
				<button type="submit" class="primary">
					<span data-ui-language-copy="en" lang="en">Save choices</span>
					<span data-ui-language-copy="th" lang="th">บันทึกตัวเลือก</span>
				</button>
				<button type="button" class="text-button" data-dialog-accept>
					<span data-ui-language-copy="en" lang="en">Accept all</span>
					<span data-ui-language-copy="th" lang="th">ยอมรับทั้งหมด</span>
				</button>
			</div>
		</form>
	</dialog>

	<p class="consent-status" data-consent-status role="status" aria-live="polite"></p>
</div>

<script>
	type ConsentSnapshot = {
		analytics: boolean;
		decided: boolean;
		updatedAt: string | null;
	};

	type StoredConsent = {
		version: number;
		analytics: boolean;
		updatedAt: string;
	};

	type ConsentApi = {
		get: () => ConsentSnapshot;
		open: () => void;
	};

	type UiLanguage = "en" | "th";
	type ConsentStatusMessage = "storage-failed" | "withdrawal-unconfirmed";

	type ConsentWindow = Window &
		typeof globalThis & {
			gtag?: (...args: unknown[]) => void;
			icerustConsent?: ConsentApi;
		};

	const STORAGE_KEY = "icerust_consent_v2";
	const CONSENT_VERSION = 2;
	const CONSENT_MAX_AGE_MS = 180 * 24 * 60 * 60 * 1000;
	const CONSENT_CHANGE_EVENT = "icerust:consent-change";
	const CONSENT_OPEN_EVENT = "icerust:consent-open";
	const UI_LANGUAGE_CHANGE_EVENT = "icerust:language-change";
	const CONSENT_STATUS_MESSAGES: Record<
		ConsentStatusMessage,
		Record<UiLanguage, string>
	> = {
		"storage-failed": {
			en: "This browser could not remember your choice, so you may be asked again next time.",
			th: "บันทึกตัวเลือกในเบราว์เซอร์ไม่ได้ ระบบจะถามอีกครั้งในครั้งถัดไป",
		},
		"withdrawal-unconfirmed": {
			en: "Analytics is disabled for this page, but the browser could not safely confirm the saved withdrawal.",
			th: "ปิด Analytics สำหรับหน้านี้แล้ว แต่เบราว์เซอร์ไม่อนุญาตให้ยืนยันการถอนความยินยอมอย่างปลอดภัย",
		},
	};

	const consentWindow = window as ConsentWindow;
	const manager = document.querySelector<HTMLElement>("[data-consent-manager]");

	if (manager && manager.dataset.initialized !== "true") {
		manager.dataset.initialized = "true";

		const banner = manager.querySelector<HTMLElement>("[data-consent-banner]");
		const dialog = manager.querySelector<HTMLDialogElement>("[data-consent-dialog]");
		const form = manager.querySelector<HTMLFormElement>("[data-consent-form]");
		const analyticsInput = manager.querySelector<HTMLInputElement>("[data-consent-analytics]");
		const status = manager.querySelector<HTMLElement>("[data-consent-status]");

		let state: ConsentSnapshot = {
			analytics: false,
			decided: false,
			updatedAt: null,
		};
		let restoreFocusTo: HTMLElement | null = null;
		let currentStatusMessage: ConsentStatusMessage | null = null;

		const getSnapshot = (): ConsentSnapshot => ({ ...state });

		const getUiLanguage = (): UiLanguage =>
			document.documentElement.dataset.uiLanguage === "th" ? "th" : "en";

		const announce = (message: ConsentStatusMessage | null) => {
			currentStatusMessage = message;
			if (status) {
				status.textContent = message ? CONSENT_STATUS_MESSAGES[message][getUiLanguage()] : "";
			}
		};

		const removeStoredConsent = () => {
			try {
				localStorage.removeItem(STORAGE_KEY);
			} catch {
				// Storage can be disabled or unavailable. Denied remains the in-memory default.
			}
		};

		const readStoredConsent = (): StoredConsent | null => {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;

				const parsed = JSON.parse(raw) as Partial<StoredConsent>;
				const updatedAtMs =
					typeof parsed.updatedAt === "string" ? Date.parse(parsed.updatedAt) : Number.NaN;
				const age = Date.now() - updatedAtMs;
				const isValid =
					parsed.version === CONSENT_VERSION &&
					typeof parsed.analytics === "boolean" &&
					Number.isFinite(updatedAtMs) &&
					age >= 0 &&
					age < CONSENT_MAX_AGE_MS;

				if (!isValid) {
					removeStoredConsent();
					return null;
				}

				return parsed as StoredConsent;
			} catch {
				removeStoredConsent();
				return null;
			}
		};

		const persistConsent = (consent: StoredConsent): boolean => {
			const serialized = JSON.stringify(consent);
			try {
				localStorage.setItem(STORAGE_KEY, serialized);
				return localStorage.getItem(STORAGE_KEY) === serialized;
			} catch {
				return false;
			}
		};

		const storedAnalyticsState = (): "allowed" | "denied" | "unknown" => {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return "denied";
				try {
					const parsed = JSON.parse(raw) as Partial<StoredConsent>;
					return parsed.version === CONSENT_VERSION && parsed.analytics === true
						? "allowed"
						: "denied";
				} catch {
					// Malformed storage defaults to denied during the next initialization.
					return "denied";
				}
			} catch {
				return "unknown";
			}
		};

		const updateGoogleConsent = (analytics: boolean) => {
			if (typeof consentWindow.gtag !== "function") return;
			consentWindow.gtag("consent", "update", {
				analytics_storage: analytics ? "granted" : "denied",
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
			});
		};

		const emitConsent = () => {
			consentWindow.dispatchEvent(
				new CustomEvent(CONSENT_CHANGE_EVENT, {
					detail: { analytics: state.analytics },
				}),
			);
		};

		const clearGoogleAnalyticsCookies = () => {
			const cookieNames = document.cookie
				.split(";")
				.map((cookie) => cookie.split("=")[0]?.trim())
				.filter((name): name is string => Boolean(name) && /^_ga(?:_|$)/.test(name));

			const hostname = window.location.hostname;
			const labels = hostname.split(".").filter(Boolean);
			const domainScopes = new Set<string>();
			if (labels.length > 1) {
				for (let index = 0; index < labels.length - 1; index += 1) {
					domainScopes.add(labels.slice(index).join("."));
				}
			}

			for (const name of cookieNames) {
				const expiry = `${name}=; Max-Age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
				document.cookie = expiry;
				for (const domain of domainScopes) {
					document.cookie = `${expiry}; domain=${domain}`;
					document.cookie = `${expiry}; domain=.${domain}`;
				}
			}
		};

		const closeSettings = (restoreFocus = true) => {
			if (!dialog?.open) return;
			if (!restoreFocus) restoreFocusTo = null;
			dialog.close();
		};

		const openSettings = () => {
			if (!dialog || !analyticsInput) return;
			if (dialog.open) return;

			restoreFocusTo =
				document.activeElement instanceof HTMLElement ? document.activeElement : null;
			analyticsInput.checked = state.analytics;
			dialog.showModal();
			queueMicrotask(() => analyticsInput.focus());
		};

		const saveChoice = (analytics: boolean) => {
			announce(null);
			const wasAnalyticsEnabled = state.decided && state.analytics;
			const decision: StoredConsent = {
				version: CONSENT_VERSION,
				analytics,
				updatedAt: new Date().toISOString(),
			};
			const persisted = persistConsent(decision);

			state = {
				analytics,
				decided: true,
				updatedAt: decision.updatedAt,
			};
			if (analyticsInput) analyticsInput.checked = analytics;

			if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
			if (banner) banner.hidden = true;
			closeSettings(false);
			updateGoogleConsent(analytics);

			if (!analytics && wasAnalyticsEnabled) {
				clearGoogleAnalyticsCookies();
			}

			emitConsent();

			if (!persisted) {
				announce("storage-failed");
			}

			if (!analytics && wasAnalyticsEnabled) {
				if (!persisted) removeStoredConsent();
				const storedState = persisted ? "denied" : storedAnalyticsState();
				if (storedState === "denied") {
					window.location.reload();
				} else {
					announce("withdrawal-unconfirmed");
				}
			}
		};

		consentWindow.icerustConsent = {
			get: getSnapshot,
			open: openSettings,
		};

		manager.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
			saveChoice(true);
		});
		manager.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
			saveChoice(false);
		});
		manager.querySelector("[data-consent-settings]")?.addEventListener("click", openSettings);
		manager.querySelector("[data-consent-close]")?.addEventListener("click", () => {
			closeSettings();
		});
		manager.querySelector("[data-dialog-accept]")?.addEventListener("click", () => {
			saveChoice(true);
		});
		manager.querySelector("[data-dialog-reject]")?.addEventListener("click", () => {
			saveChoice(false);
		});

		form?.addEventListener("submit", (event) => {
			event.preventDefault();
			saveChoice(Boolean(analyticsInput?.checked));
		});

		dialog?.addEventListener("close", () => {
			const focusTarget = restoreFocusTo;
			restoreFocusTo = null;
			if (focusTarget?.isConnected && !focusTarget.closest("[hidden]")) {
				focusTarget.focus();
			}
		});

		consentWindow.addEventListener(CONSENT_OPEN_EVENT, openSettings);
		consentWindow.addEventListener(UI_LANGUAGE_CHANGE_EVENT, () => {
			if (currentStatusMessage && status) {
				status.textContent = CONSENT_STATUS_MESSAGES[currentStatusMessage][getUiLanguage()];
			}
		});

		const storedConsent = readStoredConsent();
		if (storedConsent) {
			state = {
				analytics: storedConsent.analytics,
				decided: true,
				updatedAt: storedConsent.updatedAt,
			};
			if (analyticsInput) analyticsInput.checked = storedConsent.analytics;
			if (banner) banner.hidden = true;
			updateGoogleConsent(storedConsent.analytics);
		} else {
			if (analyticsInput) analyticsInput.checked = false;
			if (banner) banner.hidden = false;
			updateGoogleConsent(false);
		}

		emitConsent();
	}
</script>

<style>
	.consent-manager,
	.consent-manager button,
	.consent-manager input {
		font-family: var(--font-sans), var(--font-thai), system-ui, sans-serif;
	}

	.consent-banner {
		position: fixed;
		z-index: 1000;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
		left: max(1rem, env(safe-area-inset-left));
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.25rem 2rem;
		align-items: end;
		width: min(68rem, calc(100% - 2rem));
		box-sizing: border-box;
		margin-inline: auto;
		padding: 1.25rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		background: rgb(var(--cream));
		box-shadow: var(--box-shadow);
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.consent-banner[hidden] {
		display: none;
	}

	.consent-copy h2,
	.consent-dialog h2 {
		margin: 0 0 0.6rem;
		font-size: 1.25rem;
		letter-spacing: -0.015em;
	}

	.consent-copy p {
		max-width: 48rem;
		margin: 0;
	}

	.consent-copy a {
		display: inline-block;
		margin-top: 0.55rem;
		font-weight: 700;
	}

	.consent-actions,
	.dialog-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: center;
	}

	.consent-manager button {
		min-height: 2.75rem;
		padding: 0.62rem 0.9rem;
		border: 1px solid rgb(var(--gray));
		border-radius: 999px;
		background: transparent;
		color: rgb(var(--black));
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.25;
		cursor: pointer;
	}

	.consent-manager button:hover {
		border-color: rgb(var(--black));
		background: rgba(var(--gray-light), 0.55);
	}

	.consent-manager button.primary {
		border-color: rgb(var(--black));
		background: rgb(var(--black));
		color: rgb(var(--cream));
	}

	.consent-manager button.primary:hover {
		background: rgb(var(--gray-dark));
	}

	.consent-manager button.text-button {
		padding-inline: 0.35rem;
		border-color: transparent;
		border-radius: 4px;
		color: var(--accent-dark);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.consent-manager :where(button, a, input):focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	.consent-dialog {
		width: min(38rem, calc(100% - 2rem));
		max-height: min(42rem, calc(100dvh - 2rem));
		box-sizing: border-box;
		padding: 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 18px;
		background: rgb(var(--cream));
		box-shadow: var(--box-shadow);
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		line-height: 1.55;
		overflow: auto;
	}

	.consent-dialog::backdrop {
		background: rgba(var(--black), 0.58);
	}

	.consent-dialog-content {
		padding: 1.5rem;
	}

	.dialog-heading {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		justify-content: space-between;
	}

	.eyebrow {
		margin: 0 0 0.25rem;
		color: var(--accent-dark);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.consent-manager button.close-button {
		flex: none;
		width: 2.75rem;
		padding: 0;
		font-size: 1.6rem;
		font-weight: 400;
	}

	.dialog-description {
		margin: 0.5rem 0 1.25rem;
	}

	.consent-options {
		border-block: 1px solid rgb(var(--gray-light));
	}

	.consent-option {
		display: grid;
