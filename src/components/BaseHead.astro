---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { GA_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION, SITE_TITLE } from '../consts';
import type { UiLanguage } from '../i18n';
import { Font } from 'astro:assets';
import GoogleAnalytics from './GoogleAnalytics.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	lang?: UiLanguage;
	/** Pathnames of this page in each language, when translations exist. */
	translations?: Partial<Record<UiLanguage, string>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, lang = 'en', translations } = Astro.props;

// Env var wins so the token can live in the host's settings instead of the repo.
// Anything that doesn't look like a real token renders nothing, so a placeholder
// never ships as a broken tag.
const verificationToken = (
	import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? GOOGLE_SITE_VERIFICATION
).trim();
const googleSiteVerification = /^[A-Za-z0-9_-]{20,}$/.test(verificationToken)
	? verificationToken
	: null;

const OG_LOCALE: Record<UiLanguage, string> = { en: 'en_US', th: 'th_TH' };
const alternates = Object.entries(translations ?? {}) as [UiLanguage, string][];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<script is:inline>
	(() => {
		const storageKey = 'icerust_ui_language_v1';
		const root = document.documentElement;
		const isLanguageDocument = root.hasAttribute('data-ui-language-document');
		const hashLanguage = isLanguageDocument
			? window.location.hash === '#privacy-th'
				? 'th'
				: window.location.hash === '#privacy-en'
					? 'en'
					: null
			: null;
		let language = hashLanguage || 'en';

		if (!hashLanguage) {
			try {
				const storedLanguage = window.localStorage.getItem(storageKey);
				language = storedLanguage === 'th' || storedLanguage === 'en' ? storedLanguage : 'en';
			} catch {
				language = 'en';
			}
		}

		root.dataset.uiLanguage = language;
		if (isLanguageDocument) root.lang = language;

		if (hashLanguage) {
			try {
				window.localStorage.setItem(storageKey, hashLanguage);
			} catch {
				// The selected language still applies when storage is unavailable.
			}
		}
	})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{
	googleSiteVerification && (
		<meta name="google-site-verification" content={googleSiteVerification} />
	)
}
<GoogleAnalytics measurementId={GA_MEASUREMENT_ID} />

<Font cssVariable="--font-serif" preload />
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-thai" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Translations -->
{
	alternates.map(([code, path]) => (
		<link rel="alternate" hreflang={code} href={new URL(path, Astro.site)} />
	))
}
{
	translations?.en && (
		<link rel="alternate" hreflang="x-default" href={new URL(translations.en, Astro.site)} />
	)
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{
	alternates
		.filter(([code]) => code !== lang)
		.map(([code]) => <meta property="og:locale:alternate" content={OG_LOCALE[code]} />)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
