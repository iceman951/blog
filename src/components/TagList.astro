---
/** Tag chips: 4px radius, hairline, no colour fill (DESIGN.md §4–5). */
interface Props {
	tags?: readonly string[];
	/** `inline` collapses to a middot-separated meta line for listings. */
	variant?: 'chips' | 'inline';
}
const { tags, variant = 'chips' } = Astro.props;
---

{
	tags && tags.length > 0 && (
		<ul class:list={['tags', variant]}>
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
		margin: 0;
	}
	.chips {
		gap: var(--space-2);
	}
	.chips li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-alt);
		color: var(--text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}
	.inline {
		gap: 0.5em;
		color: var(--text-faint);
		font-size: 0.8rem;
	}
	.inline li + li::before {
		margin-right: 0.5em;
		content: '·';
	}
</style>
