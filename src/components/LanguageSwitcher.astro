<div
	class="language-switcher"
	role="group"
	aria-label="Choose interface language"
	data-ui-en-aria-label="Choose interface language"
	data-ui-th-aria-label="เลือกภาษาสำหรับส่วนติดต่อ"
>
	<button type="button" data-ui-language-option="th" aria-pressed="false">
		<span lang="en">TH</span>
	</button>
	<span class="divider" aria-hidden="true">|</span>
	<button type="button" data-ui-language-option="en" aria-pressed="true">
		<span lang="en">EN</span>
	</button>
</div>

<script>
	type UiLanguage = 'en' | 'th';

	const storageKey = 'icerust_ui_language_v1';
	const root = document.documentElement;
	const normalizeLanguage = (value: string | null | undefined): UiLanguage =>
		value === 'th' ? 'th' : 'en';

	const persistLanguage = (language: UiLanguage) => {
		try {
			window.localStorage.setItem(storageKey, language);
		} catch {
			// Keep the in-memory choice when browser storage is unavailable.
		}
	};

	const syncPrivacyHash = (language: UiLanguage) => {
		if (!root.hasAttribute('data-ui-language-document')) return;

		const nextHash = `#privacy-${language}`;
		if (window.location.hash === nextHash) return;

		window.history.replaceState(
			window.history.state,
			'',
			`${window.location.pathname}${window.location.search}${nextHash}`,
		);
	};

	const localizeAttribute = (
		language: UiLanguage,
		selector: string,
		attribute: 'aria-label' | 'aria-describedby',
		englishDataKey: 'uiEnAriaLabel' | 'uiEnAriaDescribedby',
		thaiDataKey: 'uiThAriaLabel' | 'uiThAriaDescribedby',
	) => {
		document.querySelectorAll<HTMLElement>(selector).forEach((element) => {
			const value = element.dataset[language === 'th' ? thaiDataKey : englishDataKey];
			if (value === undefined) {
				element.removeAttribute(attribute);
				return;
			}
			element.setAttribute(attribute, value);
		});
	};

	const applyLanguage = (
		language: UiLanguage,
		options: { persist?: boolean; updateHash?: boolean } = {},
	) => {
		root.dataset.uiLanguage = language;

		if (root.hasAttribute('data-ui-language-document')) {
			root.lang = language;
		}

		document.querySelectorAll<HTMLElement>('[data-ui-language-region]').forEach((region) => {
			region.lang = language;
		});

		document.querySelectorAll<HTMLElement>('[data-ui-language-copy]').forEach((copy) => {
			copy.hidden = copy.dataset.uiLanguageCopy !== language;
		});

		document.querySelectorAll<HTMLElement>('[data-ui-language-panel]').forEach((panel) => {
			panel.hidden = panel.dataset.uiLanguagePanel !== language;
		});

		document.querySelectorAll<HTMLButtonElement>('[data-ui-language-option]').forEach((button) => {
			button.setAttribute(
				'aria-pressed',
				String(button.dataset.uiLanguageOption === language),
			);
		});

		localizeAttribute(
			language,
			'[data-ui-en-aria-label], [data-ui-th-aria-label]',
			'aria-label',
			'uiEnAriaLabel',
			'uiThAriaLabel',
		);
		localizeAttribute(
			language,
			'[data-ui-en-aria-describedby], [data-ui-th-aria-describedby]',
			'aria-describedby',
			'uiEnAriaDescribedby',
			'uiThAriaDescribedby',
		);

		if (options.persist) persistLanguage(language);
		if (options.updateHash) syncPrivacyHash(language);

		window.dispatchEvent(
			new CustomEvent('icerust:language-change', { detail: { language } }),
		);
	};

	/**
	 * Pages that exist as a separate document per language (blog posts) advertise
	 * their counterparts on <html>. Everywhere else the switcher only toggles
	 * panels, exactly as before.
	 */
	const translationTarget = (language: UiLanguage) => {
		const target =
			language === 'th' ? root.dataset.translationTh : root.dataset.translationEn;
		if (!target) return null;

		const strip = (path: string) => path.replace(/\/+$/, '');
		return strip(target) === strip(window.location.pathname) ? null : target;
	};

	const initialLanguage = normalizeLanguage(root.dataset.uiLanguage);
	applyLanguage(initialLanguage);

	document.querySelectorAll<HTMLButtonElement>('[data-ui-language-option]').forEach((button) => {
		button.addEventListener('click', () => {
			const language = normalizeLanguage(button.dataset.uiLanguageOption);

			const target = translationTarget(language);
			if (target) {
				persistLanguage(language);
				window.location.assign(target);
				return;
			}

			applyLanguage(language, { persist: true, updateHash: true });
		});
	});

	if (root.hasAttribute('data-ui-language-document')) {
		window.addEventListener('hashchange', () => {
			const language =
				window.location.hash === '#privacy-th'
					? 'th'
					: window.location.hash === '#privacy-en'
						? 'en'
						: null;
			if (!language || root.dataset.uiLanguage === language) return;
			applyLanguage(language, { persist: true });
		});
	}
</script>

<style>
	.language-switcher {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--stack-meta);
	}

	.divider {
		color: var(--line);
		font-size: 0.78rem;
	}

	button {
		display: inline-flex;
		min-width: 30px;
		min-height: 44px;
		align-items: center;
		justify-content: center;
		padding: 0;
		position: relative;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		line-height: 1;
		cursor: pointer;
		transition: color var(--duration) var(--ease);
	}

	button:hover {
		color: var(--ink);
	}

	/* The selected language is marked by a vermilion rule, not a filled chip. */
	button[aria-pressed='true'] {
		color: var(--ink);
	}

	button[aria-pressed='true']::after {
		position: absolute;
		bottom: 0.7rem;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--vermilion);
		content: '';
	}

	button:focus-visible {
		outline: 2px solid var(--vermilion);
		outline-offset: 2px;
	}
</style>
