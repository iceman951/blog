---
interface Props {
	title: string;
	/** Sentence describing what the chart shows, for screen readers. */
	ariaLabel: string;
	note?: string;
	width?: number;
	height?: number;
}

const { title, ariaLabel, note, width = 720, height = 420 } = Astro.props;
---

<figure class="chart">
	<p class="chart-title">{title}</p>
	<div class="chart-scroll">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-label={ariaLabel}
			preserveAspectRatio="xMidYMid meet"
		>
			<slot />
		</svg>
	</div>
	{note && <figcaption class="chart-note">{note}</figcaption>}
</figure>

<style>
	.chart {
		margin: 0 0 var(--space-12);
	}
	.chart-title {
		margin: 0 0 0.8em;
		padding-bottom: 0.5em;
		border-bottom: 1px solid var(--line-light);
		color: var(--ink);
		font-family: var(--stack-meta);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		line-height: 1.35;
		text-transform: uppercase;
	}
	/* Wide charts scroll inside their own box; the page never scrolls sideways. */
	.chart-scroll {
		overflow-x: auto;
	}
	.chart-scroll svg {
		display: block;
		width: 100%;
		height: auto;
		min-width: 320px;
	}
	.chart-note {
		margin: 0.7em 0 0;
		color: var(--ink-muted);
		font-family: var(--stack-meta);
		font-size: 0.74rem;
		line-height: 1.6;
	}
</style>
