---
interface Props {
	title: string;
	/** Sentence describing what the chart shows, for screen readers. */
	ariaLabel: string;
	note?: string;
	width?: number;
	height?: number;
}

const { title, ariaLabel, note, width = 720, height = 420 } = Astro.props;
---

<figure class="chart">
	<p class="chart-title">{title}</p>
	<div class="chart-scroll">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-label={ariaLabel}
			preserveAspectRatio="xMidYMid meet"
		>
			<slot />
		</svg>
	</div>
	{note && <figcaption class="chart-note">{note}</figcaption>}
</figure>

<style>
	.chart {
		margin: 0 0 var(--space-8);
		padding: var(--space-4) var(--space-6) var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.chart-title {
		margin: 0 0 var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--border);
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.45;
	}
	/* Wide charts scroll inside their own box; the page never scrolls sideways. */
	.chart-scroll {
		overflow-x: auto;
	}
	.chart-scroll svg {
		display: block;
		width: 100%;
		height: auto;
		min-width: 320px;
	}
	.chart-note {
		margin: var(--space-3) 0 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.6;
	}

	@media (max-width: 560px) {
		.chart {
			padding: var(--space-3) var(--space-3) var(--space-4);
		}
	}
</style>
