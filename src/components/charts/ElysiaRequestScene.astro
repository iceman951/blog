---
import type { UiLanguage } from '../../i18n';

interface Props {
	lang?: UiLanguage;
}

const { lang = 'th' } = Astro.props;
const requests = ['42', '43', '44'];
const copy = {
	th: {
		eyebrow: 'Handler ที่เราเขียน',
		sourceNote: 'Sucrose วิเคราะห์ว่าใช้ query แล้ว Elysia สร้าง pipeline สำหรับ route นี้',
		requestsLabel: 'Request ที่ส่งเข้ามา',
		requestsTitle: 'Request เข้า',
		requestNumber: (n: number) => `ครั้งที่ ${n}`,
		sent: 'ส่งแล้ว',
		pipelineLabel: 'Pipeline ที่นำกลับมาใช้',
		pipelineTitle: 'Pipeline ของ /user',
		built: 'สร้างแล้ว · ใช้ชุดเดิม',
		readQuery: 'อ่าน query',
		callHandler: 'เรียก handler',
		pipelineNote: ['สองขั้นตอนเดิม', 'ทำกับข้อมูลใหม่ทุก request'],
		responsesLabel: 'ค่าที่ handler คืน',
		responsesTitle: 'ค่าที่คืน',
		responseType: 'ชนิด string',
		done: 'เสร็จแล้ว',
		buildCount: ['สร้าง pipeline ', ' ครั้ง'],
		responseCount: ['ตอบ request แล้ว ', ' ครั้ง'],
	},
	en: {
		eyebrow: 'The handler we write',
		sourceNote: 'Sucrose finds that it uses query, then Elysia builds a pipeline for this route',
		requestsLabel: 'Incoming requests',
		requestsTitle: 'Requests in',
		requestNumber: (n: number) => `Request ${n}`,
		sent: 'Sent',
		pipelineLabel: 'Reused pipeline',
		pipelineTitle: 'Pipeline for /user',
		built: 'Built · reused',
		readQuery: 'Read query',
		callHandler: 'Call handler',
		pipelineNote: ['The same two steps,', 'run on new data every request'],
		responsesLabel: 'Values the handler returns',
		responsesTitle: 'Returned',
		responseType: 'type: string',
		done: 'Done',
		buildCount: ['Pipelines built: ', ''],
		responseCount: ['Requests answered: ', ''],
	},
} satisfies Record<UiLanguage, unknown>;
const t = copy[lang];
---

<div class="request-scene">
	<div class="source" data-step="0">
		<p class="eyebrow">{t.eyebrow}</p>
		<code>{'({ query }) => query.id'}</code>
		<p class="source-note">{t.sourceNote}</p>
	</div>
	<div class="build-link" aria-hidden="true">↓</div>
	<div class="flow-board">
		<code class="flow-token" data-flow-token aria-hidden="true"></code>
		<section class="requests" aria-label={t.requestsLabel}>
			<p class="column-title">{t.requestsTitle}</p>
			<p class="route-label"><code>GET /user</code></p>
			<ol class="request-list">
				{requests.map((id, index) => (
					<li data-request={id}>
						<span class="request-number">{t.requestNumber(index + 1)}</span>
						<code>?id={id}</code>
						<span class="request-state" data-request-state>{t.sent}</span>
					</li>
				))}
			</ol>
		</section>
		<section class="pipeline" data-step="1" aria-label={t.pipelineLabel}>
			<div class="pipeline-heading">
				<strong>{t.pipelineTitle}</strong>
				<span class="build-state" data-build-state>{t.built}</span>
			</div>
			<div class="pipeline-step" data-step="2">
				<p><span class="step-number">1</span> {t.readQuery}</p>
				<code data-query-value>query.id</code>
			</div>
			<div class="inside-arrow" aria-hidden="true">↓</div>
			<div class="pipeline-step" data-step="3">
				<p><span class="step-number">2</span> {t.callHandler}</p>
				<code data-handler-value>return query.id</code>
			</div>
			<p class="pipeline-note">{t.pipelineNote[0]} <br />{t.pipelineNote[1]}</p>
		</section>
		<section class="responses" aria-label={t.responsesLabel}>
			<p class="column-title">{t.responsesTitle}</p>
			<p class="route-label">{t.responseType}</p>
			<ol class="result-list">
				{requests.map((id, index) => (
					<li data-result={id}>
						<span class="request-number">{t.requestNumber(index + 1)}</span>
						<code data-result-value>'{id}'</code>
						<span class="result-state" data-result-state>{t.done}</span>
					</li>
				))}
			</ol>
		</section>
	</div>
	<div class="counters">
		<p>{t.buildCount[0]}<strong data-build-count>1</strong>{t.buildCount[1]}</p>
		<p>{t.responseCount[0]}<strong data-response-count>3</strong>{t.responseCount[1]}</p>
	</div>
</div>

<style>
	.request-scene { container-type: inline-size; font-size: 0.9rem; line-height: 1.7; }
	p { margin: 0; }
	code { border: 0; background: transparent; padding: 0; color: var(--indigo); font-family: var(--stack-mono); font-size: 0.85rem; overflow-wrap: anywhere; }
	.source { padding: 0.85rem 1rem; border-left: 3px solid var(--indigo); background: var(--paper); }
	.eyebrow { margin-bottom: 0.35rem; color: var(--ink-soft); font-size: 0.8rem; }
	.source > code { font-size: 0.95rem; }
	.source-note { margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-soft); }
	.build-link { padding: 0.4rem 0; text-align: center; font-size: 1.25rem; color: var(--ink-muted); }
	.flow-board { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
	.flow-token { position: absolute; top: 0; left: 0; z-index: 1; width: max-content; max-width: 100%; padding: 0.3rem 0.5rem; background: var(--indigo); color: var(--paper); opacity: 0; pointer-events: none; }
	.column-title { font-weight: 600; }
	.route-label { margin: 0.15rem 0 0.75rem; color: var(--ink-soft); font-size: 0.75rem; min-height: 1.7em; }
	.route-label code { font-size: 0.75rem; }
	.request-list, .result-list { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
	.request-list li, .result-list li { position: relative; display: grid; gap: 0.1rem; margin: 0; padding: 0.55rem 0.65rem; border: 1px solid var(--line); background: var(--paper); }
	.request-number, .request-state, .result-state { font-size: 0.7rem; color: var(--ink-soft); }
	.request-list code, .result-list code { font-size: 1rem; font-variant-numeric: tabular-nums; }
	.pipeline { position: relative; padding: 0.9rem; border: 2px solid var(--indigo); background: var(--paper); }
	.pipeline::before, .pipeline::after { position: absolute; top: 50%; color: var(--ink-muted); font-size: 1.1rem; content: '→'; }
	.pipeline::before { left: -1.3rem; }
	.pipeline::after { right: -1.3rem; }
	.pipeline-heading { margin-bottom: 1rem; }
	.pipeline-heading strong { display: block; font-size: 0.9rem; font-weight: 600; }
	.build-state { color: var(--ink-soft); font-size: 0.75rem; }
	.pipeline-step { padding: 0.65rem; border: 1px solid var(--line); }
	.pipeline-step p { margin-bottom: 0.5rem; font-weight: 500; }
	.pipeline-step code { display: block; min-height: 1.8em; font-size: 0.8rem; }
	.step-number { color: var(--ink-muted); margin-right: 0.35rem; font-variant-numeric: tabular-nums; }
	.inside-arrow { text-align: center; color: var(--ink-muted); line-height: 1.8; }
	.pipeline-note { margin-top: 0.75rem; color: var(--ink-soft); font-size: 0.75rem; }
	.counters { display: flex; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--line); font-size: 0.8rem; }
	.counters strong { display: inline; color: var(--indigo); font-size: 1.1rem; font-variant-numeric: tabular-nums; }
	[data-current], [data-request][data-active], [data-result][data-active] { outline: 2px solid var(--vermilion); outline-offset: -2px; background: var(--paper-deep); }
	[data-request][data-active] .request-state, [data-result][data-active] .result-state { color: var(--vermilion); font-weight: 600; }
	[data-result][data-pending] code { color: var(--ink-muted); }
	@container (max-width: 520px) {
		.flow-board { grid-template-columns: 1fr; gap: 1.5rem; }
		.request-list, .result-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.request-list li, .result-list li { padding: 0.5rem; }
		.request-list code, .result-list code { font-size: 0.9rem; }
		.pipeline { display: grid; grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr); gap: 0.5rem; }
		.pipeline-heading, .pipeline-note { grid-column: 1 / -1; margin: 0; }
		.pipeline-heading { margin-bottom: 0.5rem; }
		.pipeline::before, .pipeline::after { content: '↓'; top: auto; left: 50%; right: auto; transform: translateX(-50%); }
		.pipeline::before { top: -1.6rem; }
		.pipeline::after { bottom: -1.6rem; }
		.inside-arrow { align-self: center; font-size: 0; }
		.inside-arrow::after { content: '→'; font-size: 1rem; }
		.pipeline-step { padding: 0.5rem; }
		.pipeline-step p { font-size: 0.85rem; }
		.pipeline-note br { display: none; }
		.counters { font-size: 0.75rem; }
	}
</style>
