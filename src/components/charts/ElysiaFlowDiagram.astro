---
import ElysiaDiagramIcon from './ElysiaDiagramIcon.astro';
import ElysiaRequestScene from './ElysiaRequestScene.astro';

interface Props {
	kind: 'handler' | 'parsing' | 'compilation';
}

const { kind } = Astro.props;
const diagramId = `elysia-${kind}-${crypto.randomUUID()}`;
const titles = {
	handler: 'สร้าง pipeline แล้วใช้กับ request ถัดไปอย่างไร?',
	parsing: 'Route ใช้แค่ query ต้องเตรียมอะไรบ้าง?',
	compilation: 'งานสร้าง handler เกิดขึ้นตอนไหน?',
};
const steps = [
	{ title: 'เขียน route handler' },
	{ title: 'วิเคราะห์การใช้ context' },
	{ title: 'ประกอบ pipeline' },
	{ title: 'ใช้กับแต่ละ request' },
];
const phases = ['ตอน build', 'ตอนเริ่มแอป', 'Request แรก', 'Request ถัดไป'];
const timelines = [
	{ title: 'Elysia 1.4.30 · precompile: true', note: 'เปิด aot และประกอบ route ก่อนเริ่มรับ request', compile: 1, actions: ['ยังไม่ประกอบ', 'ประกอบ handler', 'เรียกใช้', 'ใช้โค้ดเดิม'] },
	{ title: 'Elysia 1.4.30 · lazy compilation', note: 'เปิด aot และรอประกอบเมื่อเรียก route ครั้งแรก', compile: 2, actions: ['ยังไม่ประกอบ', 'รอเรียกครั้งแรก', 'ประกอบแล้วใช้', 'ใช้โค้ดเดิม'] },
	{ title: 'Elysia 2 beta · build-time AOT', note: 'ใช้ AOT build plugin เตรียมโค้ดไว้ใน build output', compile: 0, actions: ['ประกอบ handler', 'โหลดโค้ดที่สร้างไว้', 'เรียกใช้', 'ใช้โค้ดเดิม'] },
];
const animation = kind === 'handler' ? [
	{ step: 0, text: 'เริ่มจากโค้ดของเรา: route นี้อ่านแค่ query.id' },
	{ step: 1, text: 'Sucrose อ่านโค้ดโดยไม่รัน handler และพบว่า handler นี้ใช้ query' },
	{ step: 2, text: 'Elysia ใช้ผลวิเคราะห์ร่วมกับ hooks, schema และ HTTP method เพื่อประกอบ pipeline สำหรับ route นี้' },
	{ step: 3, id: '42', text: "Request ที่ 1: /user?id=42 → อ่าน query ของ request นี้ → handler คืน string '42'" },
	{ step: 3, id: '43', text: "Request ที่ 2: /user?id=43 → ใช้โค้ด pipeline เดิม แต่อ่าน query ใหม่ → คืน '43'" },
	{ step: 3, id: '44', text: "Request ที่ 3: /user?id=44 → คืน '44' สิ่งที่ใช้ซ้ำคือโค้ด ไม่ใช่คำตอบจาก request ก่อน" },
] : kind === 'compilation' ? [
	{ step: 0, text: 'ตอน build: AOT build plugin ของ Elysia 2 beta เตรียมโค้ดที่รองรับไว้ใน build output' },
	{ step: 1, text: 'ตอนเริ่มแอป: precompile สร้าง handler ส่วน build-time AOT โหลดโค้ดที่สร้างไว้แล้ว' },
	{ step: 2, text: 'Request แรกของ route: แบบ lazy ต้องสร้าง handler ก่อน ส่วนอีกสองแบบใช้ที่เตรียมไว้' },
	{ step: 3, text: 'Request ถัดไป: ทั้งสามแบบใช้โค้ด handler เดิม ต่างกันที่ช่วงเวลาที่ประกอบโค้ด' },
] : [];
---

<elysia-flow-player data-frames={JSON.stringify(animation)}>
<figure class="elysia-diagram" aria-labelledby={`${diagramId}-title`}>
	<p class="diagram-title" id={`${diagramId}-title`}>{titles[kind]}</p>
	{animation.length > 0 && (
		<div class="player-controls" hidden>
			<p class="player-invitation">กดเล่นเพื่อดูลำดับการทำงาน หรือเลือกดูทีละขั้น</p>
			<div class="player-buttons">
				<button type="button" data-play aria-controls={`${diagramId}-graphic`}>
					<svg class="play-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
						<path class="icon-play" d="M7 3v18l15-9z" fill="currentColor" />
						<path class="icon-pause" d="M5 4h5v16H5zm9 0h5v16h-5z" fill="currentColor" />
					</svg>
					<span data-play-label>เล่นภาพเคลื่อนไหว</span>
				</button>
				<div class="secondary-controls">
					<button type="button" data-previous aria-controls={`${diagramId}-graphic`}>← ย้อนกลับ</button>
					<button type="button" data-next aria-controls={`${diagramId}-graphic`}>ขั้นถัดไป →</button>
					<button type="button" data-reset aria-controls={`${diagramId}-graphic`}>ดูภาพรวม</button>
				</div>
			</div>
			<p class="player-status" role="status" aria-live="polite" aria-atomic="true">กดเล่นหรือดูทีละขั้น — แสดงลำดับแนวคิด ไม่ใช่ระยะเวลาที่วัดจริง</p>
		</div>
	)}
	{kind === 'handler' && (
		<>
			<div id={`${diagramId}-graphic`}>
			<ElysiaRequestScene />
			<ol class="handler-flow">
				{steps.map((step, index) => (
					<li data-step={index}>
						<span class="step-number" aria-hidden="true">{index + 1}</span>
						<div>
							<strong>{step.title}</strong>
						</div>
					</li>
				))}
			</ol>
			</div>
			<p class="takeaway">ใช้โค้ด pipeline เดิม แต่เตรียม context และอ่าน query ใหม่ทุก request</p>
			<figcaption>ภาพแสดงเฉพาะส่วนที่เกี่ยวกับ query ของ route นี้ โดยไม่มี hooks หรือ schema ที่ต้องใช้ข้อมูลส่วนอื่น การประกอบ pipeline เกิดตอน build, startup หรือ request แรกตามโหมดที่ใช้ ส่วน engine JIT ยังทำงานระหว่างรันได้ ภาพไม่ได้แสดงเวลาที่วัดจริง</figcaption>
		</>
	)}
	{kind === 'parsing' && (
		<>
			<div class="parsing-comparison">
				<div class="parse-path">
					<p class="path-title">ฟังก์ชันกลาง (แบบจำลอง)<span class="detail">เรียกขั้นตอนเตรียมข้อมูลทุกส่วน</span></p>
					<p class="endpoint"><code>GET /user?id=42</code></p>
					<span class="down-arrow" aria-hidden="true">↓</span>
					<ul class="parse-list">
						<li><span class="data-icon"><ElysiaDiagramIcon name="package" /></span> body</li>
						<li class="needed"><span class="data-icon"><ElysiaDiagramIcon name="search" /></span> query <span class="used-label">ใช้จริง ✓</span></li>
						<li><span class="data-icon"><ElysiaDiagramIcon name="code" /></span> headers</li>
						<li><span class="data-icon"><ElysiaDiagramIcon name="package" /></span> cookies</li>
					</ul>
					<span class="down-arrow" aria-hidden="true">↓</span>
					<p class="endpoint">Handler อ่าน query.id</p>
				</div>
				<div class="parse-path specialized">
					<p class="path-title">Pipeline ของ Elysia<span class="detail">เตรียมเฉพาะข้อมูลที่ route นี้ใช้</span></p>
					<p class="endpoint"><code>GET /user?id=42</code></p>
					<span class="down-arrow" aria-hidden="true">↓</span>
					<ul class="parse-list">
						<li class="needed"><span class="data-icon"><ElysiaDiagramIcon name="search" /></span> query <span class="used-label">ใช้จริง ✓</span></li>
					</ul>
					<span class="down-arrow" aria-hidden="true">↓</span>
					<p class="endpoint">Handler อ่าน query.id</p>
				</div>
			</div>
			<aside class="omitted-work" aria-label="ขั้นตอนที่ Elysia ข้ามในตัวอย่างนี้">
				<p class="path-title">ขั้นตอนที่ข้ามในตัวอย่างนี้</p>
				<dl>
					<div><dt>headers / cookies</dt><dd>ไม่ต้องเตรียมใน context เพราะ handler, hooks และ schema ไม่ได้ใช้</dd></div>
					<div><dt>body</dt><dd>ไม่สร้างขั้นตอน parse สำหรับ GET / HEAD ตามเงื่อนไข HTTP method</dd></div>
				</dl>
			</aside>
			<p class="takeaway">ได้ข้อมูลที่ handler ต้องใช้เหมือนกัน แต่เตรียมข้อมูลน้อยลง</p>
			<figcaption>ฝั่งซ้ายเป็นแบบจำลองในบทความ ส่วนฝั่งขวาอ้างอิง Elysia 1.4.30 และสมมติว่าไม่มี hooks หรือ schema ที่ใช้ข้อมูลส่วนอื่น Request ยังมี headers ได้แม้ไม่เตรียมใน context ภาพนี้ไม่ได้เปรียบเทียบความเร็วหรือแทนพฤติกรรมของ framework อื่นทุกตัว</figcaption>
		</>
	)}
	{kind === 'compilation' && (
		<>
			<div class="timelines" id={`${diagramId}-graphic`}>
				{timelines.map((timeline) => (
					<div class="timeline-row">
						<p class="path-title">{timeline.title}<span class="detail">{timeline.note}</span></p>
						<ol class="timeline">
							{timeline.actions.map((action, index) => (
								<li data-step={index} class:list={{ compilation: index === timeline.compile }}>
									<span class="phase">{phases[index]}</span>
									<span class="timeline-picture" data-illustration={index === timeline.compile ? 'build' : 'ready'}>
										<ElysiaDiagramIcon name={index < timeline.compile ? 'wait' : index === timeline.compile ? 'build' : index === 1 ? 'package' : 'ready'} />
										{index >= 2 && <span class="timeline-packet" data-delivery><ElysiaDiagramIcon name="request" /></span>}
									</span>
									<strong>{action}</strong>
								</li>
							))}
						</ol>
					</div>
				))}
			</div>
			<p class="takeaway">ชิ้นส่วนจิ๊กซอว์ = กำลังเตรียม · ไฟล์ ✓ = พร้อมใช้ · ซอง = request ที่เข้ามา</p>
			<figcaption>แสดงเฉพาะงานสร้าง handler: <code>precompile: true</code> ย้ายงานแบบ lazy ไป startup ได้ ส่วน engine JIT เป็นอีกชั้นหนึ่งและยังเกิดระหว่างรันได้ในทั้งสามแบบ</figcaption>
		</>
	)}
</figure>
</elysia-flow-player>

<script>
	type Frame = { step: number; text: string; id?: string };

	class ElysiaFlowPlayer extends HTMLElement {
		connectedCallback() {
			const frames: Frame[] = JSON.parse(this.dataset.frames ?? '[]');
			const controls = this.querySelector<HTMLElement>('.player-controls');
			if (!frames.length || !controls || this.cleanup) return;
			const events = new AbortController();
			const play = this.querySelector<HTMLButtonElement>('[data-play]')!;
			const playLabel = this.querySelector<HTMLElement>('[data-play-label]')!;
			const previous = this.querySelector<HTMLButtonElement>('[data-previous]')!;
			const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
			const reset = this.querySelector<HTMLButtonElement>('[data-reset]')!;
			const status = this.querySelector<HTMLElement>('.player-status')!;
			const nodes = this.querySelectorAll<HTMLElement>('[data-step]');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let position = -1;
			let timer: ReturnType<typeof setInterval> | undefined;
			let motions: Animation[] = [];
			const move = (selector: string, keyframes: Keyframe[], duration = 1600, delay = 0) => {
				for (const element of this.querySelectorAll<HTMLElement | SVGElement>(selector)) {
					if (typeof element.animate === 'function') {
						motions.push(element.animate(keyframes, { duration, delay, easing: 'ease-in-out', fill: 'both' }));
					}
				}
			};
			const idleLabel = () => position === frames.length - 1 ? 'เริ่มใหม่' : reducedMotion.matches ? position === -1 ? 'เริ่มดูทีละขั้น' : 'ดูขั้นถัดไป' : position >= 0 ? 'เล่นต่อ' : 'เล่นภาพเคลื่อนไหว';
			const pause = () => {
				clearInterval(timer);
				timer = undefined;
				motions.forEach((motion) => motion.pause());
				status.setAttribute('aria-live', 'polite');
				playLabel.textContent = idleLabel();
				play.toggleAttribute('data-playing', false);
			};
			const show = (animate = false) => {
				motions.forEach((motion) => motion.cancel());
				motions = [];
				const frame = frames[position];
				const requestId = frame?.id ?? '42';
				const requestLabel = this.querySelector('[data-request-label]');
				const responseLabel = this.querySelector('[data-response-label]');
				if (requestLabel) requestLabel.textContent = `/user?id=${requestId}`;
				if (responseLabel) responseLabel.textContent = `'${requestId}'`;
				this.dataset.stage = frame ? String(frame.step) : 'overview';
				for (const node of nodes) {
					const active = Boolean(frame && Number(node.dataset.step) === frame.step);
					node.toggleAttribute('data-current', active);
					if (active) node.setAttribute('aria-current', 'step');
					else node.removeAttribute('aria-current');
				}
				status.textContent = frame
					? `${position + 1}/${frames.length} — ${frame.text}`
					: 'กดเล่นหรือดูทีละขั้น — แสดงลำดับแนวคิด ไม่ใช่ระยะเวลาที่วัดจริง';
				previous.disabled = position <= 0;
				next.disabled = position === frames.length - 1;
				reset.disabled = position === -1;
				if (timer === undefined) playLabel.textContent = idleLabel();
				if (animate && frame && !reducedMotion.matches) {
					if (frame.step === 1) move('.scanner', [{ transform: 'translateX(-70px)' }, { transform: 'translateX(0)' }]);
					if (frame.step === 2) move('.query-assembly', [{ transform: 'translateY(-85px)', opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }]);
					if (frame.step === 3) {
						move('[data-packet]', [{ transform: 'translateX(0)', offset: 0 }, { transform: 'translateX(110px)', offset: 0.4 }, { transform: 'translateX(110px)', offset: 0.6 }, { transform: 'translateX(305px)', offset: 1 }]);
						move('.response', [{ opacity: 0.25 }, { opacity: 1 }], 400, 1200);
					}
					move('[data-current] [data-illustration="build"] > svg', [{ transform: 'translateY(-12px)', opacity: 0.3 }, { transform: 'translateY(0)', opacity: 1 }], 800);
					move('[data-current] [data-delivery]', [{ transform: 'translateX(-35px)', opacity: 0 }, { transform: 'translateX(0)', opacity: 1, offset: 0.3 }, { transform: 'translateX(35px)', opacity: 0 }], 1000, 800);
				}
			};
			const start = () => {
				if (timer !== undefined) return;
				// Announce manual steps, but keep timed playback quiet for screen readers.
				status.setAttribute('aria-live', reducedMotion.matches ? 'polite' : 'off');
				if (position === -1 || position === frames.length - 1 || reducedMotion.matches) {
					position = (position + 1) % frames.length;
					show(true);
				}
				if (reducedMotion.matches) return pause();
				motions.forEach((motion) => motion.play());
				playLabel.textContent = 'หยุดชั่วคราว';
				play.toggleAttribute('data-playing', true);
				timer = setInterval(() => {
					if (position === frames.length - 1) return pause();
					position += 1;
					show(true);
				}, 6000);
			};
			play.addEventListener('click', () => { if (timer !== undefined) pause(); else start(); }, { signal: events.signal });
			previous.addEventListener('click', () => {
				pause();
				position = Math.max(position - 1, 0);
				show();
			}, { signal: events.signal });
			next.addEventListener('click', () => {
				pause();
				position = Math.min(position + 1, frames.length - 1);
				show();
			}, { signal: events.signal });
			reset.addEventListener('click', () => { position = -1; pause(); show(); }, { signal: events.signal });
			const updateInvitation = () => {
				const invitation = this.querySelector<HTMLElement>('.player-invitation');
				if (invitation) invitation.textContent = reducedMotion.matches
					? 'แสดงแบบลดการเคลื่อนไหว — ใช้ปุ่มขั้นถัดไปหรือย้อนกลับเพื่ออ่านตามจังหวะของคุณ'
					: 'กดเล่นเพื่อดูลำดับการทำงาน หรือเลือกดูทีละขั้น';
			};
			const onMotionChange = () => { pause(); show(); updateInvitation(); };
			reducedMotion.addEventListener('change', onMotionChange, { signal: events.signal });
			this.cleanup = () => {
				pause();
				motions.forEach((motion) => motion.cancel());
				events.abort();
			};
			pause();
			show();
			controls.hidden = false;
			updateInvitation();
		}

		cleanup?: () => void;
		disconnectedCallback() {
			this.cleanup?.();
			this.cleanup = undefined;
		}
	}

	if (!customElements.get('elysia-flow-player')) customElements.define('elysia-flow-player', ElysiaFlowPlayer);
</script>

<style>
	elysia-flow-player { display: block; }
	.player-controls { margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
	.player-invitation { margin: 0 0 0.75rem; color: var(--ink); font-size: 0.85rem; }
	.player-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
	.secondary-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.player-buttons button {
		min-height: 44px; padding: 0.4rem 0.75rem; border: 1px solid var(--ink-muted);
		background: var(--paper); color: var(--ink); font: inherit; cursor: pointer;
	}
	.player-buttons [data-play] {
		display: inline-flex; justify-content: center; align-items: center; gap: 0.65rem;
		min-height: 54px; min-width: 14rem; padding: 0.65rem 1.1rem;
		border: 2px solid var(--indigo); background: var(--indigo); color: var(--paper);
		font-size: 1rem; font-weight: 600;
	}
	.player-buttons [data-play]:hover { background: var(--ink); border-color: var(--ink); }
	.secondary-controls button:not(:disabled):hover { background: var(--paper-deep); border-color: var(--ink); }
	.play-icon { flex-shrink: 0; }
	.icon-pause, [data-playing] .icon-play { display: none; }
	[data-playing] .icon-pause { display: block; }
	.player-buttons button:disabled { opacity: 0.5; cursor: default; }
	.player-buttons button:focus-visible { outline: 2px solid var(--vermilion); outline-offset: 3px; }
	.player-status { margin: 0.75rem 0 0; min-height: 5.1em; font-size: 0.8rem; }
	.handler-flow li[data-current] { border-color: var(--vermilion); background: var(--paper); }
	.handler-flow li[data-current] .step-number { background: var(--indigo); color: var(--paper); }
	.timeline li[data-current] { border-bottom: 4px solid var(--vermilion); background: var(--paper-deep); }
	@media print { .player-controls { display: none; } }
	.elysia-diagram {
		margin: 2rem 0 2.5rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		background: var(--paper-alt);
		color: var(--ink);
		font-family: var(--stack-meta);
		font-size: 0.85rem;
		line-height: 1.7;
	}
	.diagram-title { margin: 0 0 1.25rem; font-size: 1rem; font-weight: 600; }
	.elysia-diagram strong { display: block; font-weight: 600; }
	.detail { display: block; color: var(--ink-soft); font-size: 0.8rem; font-weight: 400; }
	.handler-flow, .parse-list, .timeline { margin: 0; padding: 0; list-style: none; }
	.handler-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; margin-top: 1rem; }
	.handler-flow li { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; margin: 0; border: 1px solid var(--line); font-size: 0.75rem; }
	.step-number { display: grid; place-items: center; flex: 0 0 1.5rem; height: 1.5rem; background: var(--paper); font-variant-numeric: tabular-nums; }
	.parsing-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
	.parse-path { display: flex; flex-direction: column; min-width: 0; }
	.path-title { margin: 0 0 0.75rem; font-weight: 600; }
	.endpoint { margin: 0; padding: 0.5rem; border: 1px solid var(--line); text-align: center; background: var(--paper); }
	.down-arrow { display: block; text-align: center; color: var(--ink-muted); line-height: 1.5; }
	.parse-list { flex: 1; }
	.parse-list li { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.5rem; margin: 0 0 0.35rem; border: 1px solid var(--line); }
	.parse-list .needed { border: 2px solid var(--indigo); background: var(--paper); }
	.needed .used-label { margin-left: auto; font-size: 0.75rem; }
	.data-icon { flex: 0 0 30px; line-height: 0; }
	.data-icon :global(svg) { width: 30px; height: 30px; }
	.timeline-picture { display: block; position: relative; width: 64px; margin: 0.5rem auto; color: var(--indigo); }
