---
import { PALETTE, SERIES, fmt, linear, ticks } from '../../lib/chart';
import ChartFrame from './ChartFrame.astro';

interface Props {
	title: string;
	ariaLabel: string;
	note?: string;
	series: { name: string; points: { x: number; y: number }[] }[];
	xLabel: string;
	yLabel: string;
	xDigits?: number;
	yDigits?: number;
	/** Draw point markers as well as the line (for sparse series). */
	markers?: boolean;
}

const { title, ariaLabel, note, series, xLabel, yLabel, xDigits = 0, yDigits = 2, markers = false } = Astro.props;

const W = 720;
const H = 400;
const LEFT = 68;
const RIGHT = 24;
const TOP = series.length > 1 ? 44 : 20;
const BOTTOM = 56;

const all = series.flatMap((s) => s.points);
const xAxis = ticks(Math.min(...all.map((p) => p.x)), Math.max(...all.map((p) => p.x)), 6);
const yAxis = ticks(Math.min(...all.map((p) => p.y)) * 0.92, Math.max(...all.map((p) => p.y)) * 1.06, 5);
const x = linear(Math.min(...xAxis), Math.max(...xAxis), LEFT, W - RIGHT);
const y = linear(Math.min(...yAxis), Math.max(...yAxis), H - BOTTOM, TOP);

const path = (pts: { x: number; y: number }[]) =>
	pts.map((p, i) => `${i ? 'L' : 'M'}${x(p.x).toFixed(1)} ${y(p.y).toFixed(1)}`).join(' ');
---

<ChartFrame title={title} ariaLabel={ariaLabel} note={note} width={W} height={H}>
	{
		series.length > 1 &&
			series.map((s, i) => (
				<g>
					<line x1={LEFT + i * 130} y1={17} x2={LEFT + i * 130 + 18} y2={17} stroke={SERIES[i % SERIES.length]} stroke-width="2" />
					<text x={LEFT + i * 130 + 24} y={21} font-size="12" fill={PALETTE.ink} font-family="var(--font-sans), var(--font-thai), system-ui, sans-serif">
						{s.name}
					</text>
				</g>
			))
	}

	{
		yAxis.map((t) => (
			<g>
				<line x1={LEFT} y1={y(t)} x2={W - RIGHT} y2={y(t)} stroke={PALETTE.grid} stroke-width="1" />
				<text x={LEFT - 10} y={y(t) + 4} text-anchor="end" font-size="11" fill={PALETTE.muted} font-family="var(--font-sans), system-ui, sans-serif">
					{fmt(t, yDigits)}
				</text>
			</g>
		))
	}
	{
		xAxis.map((t) => (
			<text x={x(t)} y={H - BOTTOM + 19} text-anchor="middle" font-size="11" fill={PALETTE.muted} font-family="var(--font-sans), system-ui, sans-serif">
				{fmt(t, xDigits)}
			</text>
		))
	}

	{
		series.map((s, i) => (
			<g>
				<path d={path(s.points)} fill="none" stroke={SERIES[i % SERIES.length]} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
				{markers &&
					s.points.map((p) => (
						<circle cx={x(p.x)} cy={y(p.y)} r="3.5" fill={SERIES[i % SERIES.length]} stroke={PALETTE.surface} stroke-width="1.5" />
					))}
			</g>
		))
	}

	<line x1={LEFT} y1={TOP} x2={LEFT} y2={H - BOTTOM} stroke={PALETTE.muted} stroke-width="1" />
	<line x1={LEFT} y1={H - BOTTOM} x2={W - RIGHT} y2={H - BOTTOM} stroke={PALETTE.muted} stroke-width="1" />
	<text x={(LEFT + W - RIGHT) / 2} y={H - 12} text-anchor="middle" font-size="12" fill={PALETTE.ink} font-family="var(--font-sans), var(--font-thai), system-ui, sans-serif">{xLabel}</text>
	<text x={15} y={(TOP + H - BOTTOM) / 2} text-anchor="middle" font-size="12" fill={PALETTE.ink} font-family="var(--font-sans), var(--font-thai), system-ui, sans-serif" transform={`rotate(-90 15 ${(TOP + H - BOTTOM) / 2})`}>{yLabel}</text>
</ChartFrame>
