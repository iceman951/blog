	title="About Vorrapong Kertnat"
	description="Vorrapong Kertnat (ICE) — full-stack developer at BAAC in Bangkok, currently studying Financial Engineering at UTCC."
	pubDate={new Date('August 18 2026')}
	kicker="Colophon / About"
	titleTh="เกี่ยวกับผม — Vorrapong Kertnat"
	kickerTh="แนะนำตัว / เกี่ยวกับผม"
	marginNote={false}
