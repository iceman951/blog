---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import PersonSchema from '../components/PersonSchema.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { t, type UiLanguage } from '../i18n';
import { editorialDate } from '../lib/dates';
import { postsForLanguage } from '../lib/posts';
import { postsForSeries, seriesForLanguage } from '../lib/series';

const all = await getCollection('blog');
const allSeries = await getCollection('series');
// Both languages ship in the same document; CSS hides the inactive panel.
const panels: UiLanguage[] = ['en', 'th'];
// The featured series in each language, with its episode count in that language.
const featuredByLanguage = (lang: UiLanguage) => {
	const candidates = seriesForLanguage(allSeries, lang);
	const entry = candidates.find((series) => series.data.featured) ?? candidates[0];
	return entry && { entry, episodes: postsForSeries(all, entry.id, entry.data.lang) };
};
const featured = panels
	.map((lang) => ({ lang, series: featuredByLanguage(lang) }))
	.filter((panel): panel is { lang: UiLanguage; series: NonNullable<ReturnType<typeof featuredByLanguage>> } =>
		panel.series !== undefined,
	);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<PersonSchema />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="intro-heading">
				<h1 id="intro-heading">
					<span data-ui-language-copy="en" lang="en">Experiment.<br />Benchmark. Build.</span>
					<span data-ui-language-copy="th" lang="th">ทดลอง วัดผล<br />และสร้างระบบ</span>
				</h1>
				<p class="intro-sub">
					<span data-ui-language-copy="en" lang="en">Understanding computers and financial markets through empirical data.</span>
					<span data-ui-language-copy="th" lang="th">เรียนรู้การทำงานของระบบคอมพิวเตอร์และโลกการเงิน ผ่านการทดสอบจริง</span>
				</p>
				<!-- The author's name in visible copy, not only the footer: the home
				     page is the one Google ranks for a name query. -->
				<p class="intro-byline">
					<span data-ui-language-copy="en" lang="en">by <a href="/about/">{SITE_TITLE}</a></span>
					<span data-ui-language-copy="th" lang="th">โดย <a href="/about/">{SITE_TITLE}</a></span>
				</p>
			</section>

			{
				featured.map(({ lang, series: { entry, episodes } }) => (
					<div data-ui-language-panel={lang}>
						<section
							class="featured-series"
							aria-labelledby={`featured-series-heading-${lang}`}
							lang={entry.data.lang}
						>
							<p class="kicker">
								{t(lang, 'featuredSeries')}
								<span class="series-count">
									{' · '}
									{lang === 'th'
										? episodes.length
											? `${episodes.length} ตอน`
											: 'กำลังเริ่มต้น'
										: episodes.length
											? `${episodes.length} ${episodes.length === 1 ? 'episode' : 'episodes'}`
											: 'Just getting started'}
								</span>
							</p>
							<h2 id={`featured-series-heading-${lang}`}>{entry.data.title}</h2>
							<p>{entry.data.description}</p>
							<a href={`/series/${entry.id}/`}>
								{t(lang, 'viewSeries')}
								<span aria-hidden="true">→</span>
							</a>
						</section>
					</div>
				))
			}

			<section class="latest" aria-labelledby="latest-heading">
				<h2 class="kicker" id="latest-heading">
					<span data-ui-language-copy="en" lang="en">Latest posts</span>
					<span data-ui-language-copy="th" lang="th">บทความล่าสุด</span>
				</h2>

				{
					panels.map((lang) => {
						const latestPosts = postsForLanguage(all, lang).slice(0, 4);

						return (
							<div data-ui-language-panel={lang} lang={lang}>
								<ol class="post-list">
									{latestPosts.map((post) => (
										<li class="post-row">
											<a href={`/blog/${post.id}/`}>
												<time class="date" datetime={post.data.pubDate.toISOString()}>
													{editorialDate(post.data.pubDate)}
												</time>
												<span class="body">
													{post.data.seriesOrder && (
														<span class="series-marker">
															{t(lang, 'series')} · {t(lang, 'episode')} {String(post.data.seriesOrder).padStart(2, '0')}
														</span>
													)}
													<span class="title">{post.data.title}</span>
													<span class="excerpt">{post.data.description}</span>
													<TagList tags={post.data.tags} variant="inline" />
												</span>
											</a>
										</li>
									))}
								</ol>
							</div>
						);
					})
				}

				<p class="all">
					<a href="/blog">
						<span data-ui-language-copy="en" lang="en">View all posts</span>
						<span data-ui-language-copy="th" lang="th">ดูบทความทั้งหมด</span>
						<span aria-hidden="true">→</span>
					</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		max-width: var(--measure-prose);
		padding: var(--space-8) 0 var(--space-16);
	}

	h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(2.2rem, 5vw, 3.25rem);
		line-height: 1.15;
	}

	.intro-sub {
		margin: 0 0 var(--space-2);
		color: var(--text-muted);
		font-size: 1.15rem;
	}

	.intro-byline {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.9rem;
	}

	.featured-series {
		margin: 0 0 var(--space-16);
		padding: var(--space-8);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.series-count {
		color: var(--text-faint);
		font-weight: 500;
	}

	.featured-series h2 {
		max-width: 32ch;
		margin-bottom: var(--space-3);
	}

	.featured-series p:not(.kicker) {
		max-width: 65ch;
		margin-bottom: var(--space-4);
		color: var(--text-muted);
	}

	.featured-series a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.5em;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
	}

	h2.kicker {
		margin-bottom: var(--space-4);
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-row {
		margin: 0;
		border-top: 1px solid var(--border);
	}

	.post-row:last-child {
		border-bottom: 1px solid var(--border);
	}

	.post-row a {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-6);
		padding: var(--space-6) 0;
		color: inherit;
		text-decoration: none;
	}

	.date {
		color: var(--text-faint);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.body {
		display: block;
		max-width: var(--measure-prose);
	}

	.title {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--text);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.35;
		transition: color var(--duration) var(--ease);
	}

	.post-row a:hover .title {
		color: var(--accent);
	}

	.excerpt {
		display: -webkit-box;
		margin-bottom: var(--space-2);
		overflow: hidden;
		color: var(--text-muted);
		font-size: 0.95rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.series-marker {
		display: block;
		margin-bottom: var(--space-1);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.all {
		margin: var(--space-8) 0 0;
		font-size: 0.95rem;
	}

	.all a {
		font-weight: 500;
		text-decoration: none;
	}

	.all span[aria-hidden] {
		margin-left: 0.4em;
	}

	@media (max-width: 860px) {
		.intro {
			padding: var(--space-4) 0 var(--space-12);
		}
		.featured-series {
			margin-bottom: var(--space-12);
			padding: var(--space-6);
		}
		.post-row a {
			grid-template-columns: 1fr;
			gap: var(--space-1);
			padding: var(--space-4) 0;
		}
		.title {
			font-size: 1.1rem;
		}
	}
</style>
