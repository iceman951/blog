---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import HankoMark from '../components/HankoMark.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import VerticalNote from '../components/VerticalNote.astro';
import BrushDivider from '../components/ink/BrushDivider.astro';
import InkMountains from '../components/ink/InkMountains.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import type { UiLanguage } from '../i18n';
import { MONTHS_SHORT } from '../lib/dates';
import { postsForLanguage } from '../lib/posts';
import { postsForSeries } from '../lib/series';

const all = await getCollection('blog');
const allSeries = await getCollection('series');
const featuredSeries = allSeries.find((entry) => entry.data.featured) ?? allSeries[0];
const featuredEpisodes = featuredSeries
	? postsForSeries(all, featuredSeries.id, featuredSeries.data.lang)
	: [];
// Both languages ship in the same document; CSS hides the inactive panel.
const panels: UiLanguage[] = ['en', 'th'];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="intro-heading">
				<div class="hero-copy">
					<h1 id="intro-heading">
						<span data-ui-language-copy="en" lang="en">Small Experiments<br />for a Better Future.</span>
						<span data-ui-language-copy="th" lang="th">การทดลองเล็ก ๆ<br />เพื่ออนาคตที่ดีกว่า</span>
					</h1>
					<p class="hero-sub">
						<span data-ui-language-copy="en" lang="en">Notes on technology, markets, and experiments.</span>
						<span data-ui-language-copy="th" lang="th">บันทึกเรื่องเทคโนโลยี ตลาด และการทดลอง</span>
					</p>
					<HankoMark />
				</div>

				<div class="hero-ink" aria-hidden="true">
					<InkMountains />
				</div>

				<aside class="hero-note">
					<hr class="rule-short" />
					<p>
						<span data-ui-language-copy="en" lang="en">Continuously<br />learning,<br />like water.</span>
						<span data-ui-language-copy="th" lang="th">เรียนรู้ต่อเนื่อง<br />เหมือนสายน้ำ</span>
					</p>
				</aside>
			</section>

			<BrushDivider />

			{
				featuredSeries && (
					<section class="featured-series" aria-labelledby="featured-series-heading" lang={featuredSeries.data.lang}>
						<div class="series-label">
							<p class="kicker">
								<span data-ui-language-copy="en" lang="en">Featured series</span>
								<span data-ui-language-copy="th" lang="th">ซีรีส์แนะนำ</span>
							</p>
							<p class="series-count">{featuredEpisodes.length ? `${featuredEpisodes.length} ตอน` : 'กำลังเริ่มต้น'}</p>
						</div>
						<div class="series-copy">
							<h2 id="featured-series-heading">{featuredSeries.data.title}</h2>
							<p>{featuredSeries.data.description}</p>
							<a href={`/series/${featuredSeries.id}/`}>
								<span data-ui-language-copy="en" lang="en">View series</span>
								<span data-ui-language-copy="th" lang="th">อ่านซีรีส์นี้</span>
								<span aria-hidden="true">⟶</span>
							</a>
						</div>
					</section>
				)
			}

			<section class="latest" aria-labelledby="latest-heading">
				<hr class="rule-short" />
				<p class="section-jp" lang="ja">最新の記事</p>
				<h2 class="kicker" id="latest-heading">
					<span data-ui-language-copy="en" lang="en">Latest writings</span>
					<span data-ui-language-copy="th" lang="th">บทความล่าสุด</span>
				</h2>

				{
					panels.map((lang) => {
						const latestPosts = postsForLanguage(all, lang).slice(0, 4);

						return (
							<div data-ui-language-panel={lang} lang={lang}>
								<ol class="post-list">
									{latestPosts.map((post) => (
										<li class="post-row">
											<a href={`/blog/${post.id}/`}>
												<time class="date" datetime={post.data.pubDate.toISOString()}>
													<span class="day">{post.data.pubDate.getDate()}</span>
													<span class="month">{MONTHS_SHORT[post.data.pubDate.getMonth()]}</span>
													<span class="year">{post.data.pubDate.getFullYear()}</span>
												</time>
											<span class="body">
												<span class="title">{post.data.title}</span>
												{post.data.seriesOrder && <span class="series-marker">Series · ตอน {String(post.data.seriesOrder).padStart(2, '0')}</span>}
												<TagList tags={post.data.tags} variant="inline" />
												</span>
												<span class="arrow" aria-hidden="true">—</span>
											</a>
										</li>
									))}
								</ol>
							</div>
						);
					})
				}

				<p class="all">
					<a href="/blog">
						<span data-ui-language-copy="en" lang="en">View all posts</span>
						<span data-ui-language-copy="th" lang="th">ดูบทความทั้งหมด</span>
						<span aria-hidden="true">⟶</span>
					</a>
				</p>
			</section>

			<!-- 継続は力なり — "perseverance is strength". -->
			<div class="margin-note">
				<VerticalNote text="継続は力なり" />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--frame);
		position: relative;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) 10rem;
		align-items: center;
		gap: var(--space-8);
		padding: var(--space-16) 0 var(--space-24);
	}

	h1 {
		margin: 0 0 var(--space-6);
		font-size: clamp(2.6rem, 6vw, 4.2rem);
		font-weight: 400;
		line-height: 1.18;
		letter-spacing: -0.02em;
	}

	.hero-sub {
		margin: 0 0 var(--space-8);
		color: var(--ink-soft);
		font-size: 1rem;
		line-height: 1.9;
	}

	.hero-ink {
		align-self: center;
	}

	.hero-note {
		align-self: end;
		padding-bottom: var(--space-8);
	}

	.hero-note p {
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--stack-meta);
		font-size: 0.8rem;
		line-height: 1.7;
	}

	.latest {
		padding: var(--space-16) 0 0;
	}

	.featured-series {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		gap: var(--space-12);
		padding: var(--space-16) 0;
		border-bottom: 1px solid var(--line-light);
	}

	.featured-series .kicker {
		margin-bottom: var(--space-2);
	}

	.series-count {
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--stack-meta);
		font-size: 0.75rem;
	}

	.series-copy h2 {
		max-width: 25ch;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
	}

	.series-copy p {
		max-width: 62ch;
	}

	.series-copy a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.6em;
		font-family: var(--stack-meta);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.section-jp {
		margin: 0 0 var(--space-2);
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.35rem;
		letter-spacing: 0.12em;
	}

	h2.kicker {
		margin-bottom: var(--space-12);
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}

	.post-row {
		margin: 0;
		border-top: 1px solid var(--line-light);
	}

	.post-row:last-child {
		border-bottom: 1px solid var(--line-light);
	}

	.post-row a {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) 2rem;
		align-items: center;
		gap: var(--space-8);
		padding: var(--space-6) 0;
		color: inherit;
		text-decoration: none;
		transition: background-color var(--duration) var(--ease);
	}

	.post-row a:hover {
		background: var(--paper-alt);
	}

	.date {
		display: block;
		font-family: var(--stack-meta);
		line-height: 1.15;
		text-align: left;
	}

	.day {
		display: block;
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.9rem;
		font-weight: 400;
	}

	.month,
	.year {
		display: block;
		color: var(--ink-muted);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
	}

	.title {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.4rem;
		line-height: 1.35;
		transition: color var(--duration) var(--ease);
	}

	.series-marker {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--vermilion);
		font-family: var(--stack-meta);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.post-row a:hover .title {
		color: var(--vermilion);
	}

	.arrow {
		color: var(--line);
		text-align: right;
	}

	.all {
		margin: var(--space-12) 0 0;
		font-family: var(--stack-meta);
		font-size: 0.85rem;
	}

	.all a {
		color: var(--ink);
		text-decoration: none;
	}

	.all a:hover {
		color: var(--vermilion);
	}

	.all span[aria-hidden] {
		margin-left: 0.6em;
	}

	.margin-note {
		position: absolute;
		right: -2.5rem;
		bottom: 12rem;
	}

	@media (max-width: 1180px) {
		.margin-note {
			display: none;
		}
	}

	@media (max-width: 1180px) {
		.hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		}
		.hero-note {
			display: none;
		}
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: var(--space-8);
			padding: var(--space-12) 0 var(--space-16);
		}
		.hero-ink {
			max-width: 22rem;
		}
		.featured-series {
			grid-template-columns: 1fr;
			gap: var(--space-4);
			padding: var(--space-12) 0;
		}
		.post-row a {
			grid-template-columns: 3.6rem minmax(0, 1fr);
			gap: var(--space-6);
		}
		.arrow {
			display: none;
		}
		.day {
			font-size: 1.5rem;
		}
		.title {
			font-size: 1.15rem;
		}
	}
</style>
