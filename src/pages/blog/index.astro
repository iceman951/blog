---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import PlumBranch from '../../components/ink/PlumBranch.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import type { UiLanguage } from '../../i18n';
import { postsForLanguage } from '../../lib/posts';

const all = await getCollection('blog');
// Both languages ship in the same document; CSS hides the inactive panel.
const panels: UiLanguage[] = ['en', 'th'];

const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<hr class="rule-short" />
				<p class="section-jp" lang="ja">記事一覧</p>
				<h1 class="kicker">
					<span data-ui-language-copy="en" lang="en">All writings</span>
					<span data-ui-language-copy="th" lang="th">บทความทั้งหมด</span>
				</h1>
			</header>

			{
				panels.map((lang) => {
					const posts = postsForLanguage(all, lang);

					return (
						<div data-ui-language-panel={lang} lang={lang}>
							<ol class="post-list">
								{posts.map((post) => (
									<li class="post-row">
										<a href={`/blog/${post.id}/`}>
											<time class="date" datetime={post.data.pubDate.toISOString()}>
												<span class="day">{post.data.pubDate.getDate()}</span>
												<span class="month">{monthNames[post.data.pubDate.getMonth()]}</span>
												<span class="year">{post.data.pubDate.getFullYear()}</span>
											</time>
											<span class="body">
												<span class="title">{post.data.title}</span>
												<span class="excerpt">{post.data.description}</span>
												<TagList tags={post.data.tags} variant="inline" />
											</span>
											<span class="arrow" aria-hidden="true">—</span>
										</a>
									</li>
								))}
							</ol>
						</div>
					);
				})
			}

			<div class="decor" aria-hidden="true">
				<PlumBranch corner="bottom-left" />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		position: relative;
		padding-bottom: var(--space-32);
	}

	.page-head {
		margin-bottom: var(--space-12);
	}

	.section-jp {
		margin: 0 0 var(--space-2);
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.35rem;
		letter-spacing: 0.12em;
	}

	h1.kicker {
		margin: 0;
		font-size: 0.7rem;
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-row {
		margin: 0;
		border-top: 1px solid var(--line-light);
	}

	.post-row:last-child {
		border-bottom: 1px solid var(--line-light);
	}

	.post-row a {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) 2rem;
		align-items: start;
		gap: var(--space-8);
		padding: var(--space-8) 0;
		color: inherit;
		text-decoration: none;
		transition: background-color var(--duration) var(--ease);
	}

	.post-row a:hover {
		background: var(--paper-alt);
	}

	.date {
		display: block;
		padding-top: 0.35rem;
		font-family: var(--stack-meta);
		line-height: 1.15;
	}

	.day {
		display: block;
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.9rem;
	}

	.month,
	.year {
		display: block;
		color: var(--ink-muted);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
	}

	.title {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--ink);
		font-family: var(--stack-display);
		font-size: 1.5rem;
		line-height: 1.3;
		transition: color var(--duration) var(--ease);
	}

	.post-row a:hover .title {
		color: var(--vermilion);
	}

	.excerpt {
		display: block;
		max-width: 60ch;
		margin-bottom: var(--space-3);
		color: var(--ink-soft);
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.arrow {
		padding-top: 0.6rem;
		color: var(--line);
		text-align: right;
	}

	.decor {
		position: absolute;
		bottom: 0;
		left: -6rem;
		width: 260px;
		height: 200px;
		pointer-events: none;
	}

	@media (max-width: 1180px) {
		.decor {
			display: none;
		}
	}

	@media (max-width: 860px) {
		.post-row a {
			grid-template-columns: 3.6rem minmax(0, 1fr);
			gap: var(--space-6);
			padding: var(--space-6) 0;
		}
		.arrow {
			display: none;
		}
		.day {
			font-size: 1.5rem;
		}
		.title {
			font-size: 1.2rem;
		}
		.excerpt {
			font-size: 0.86rem;
		}
	}
</style>
