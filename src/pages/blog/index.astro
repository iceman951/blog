---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { t, type UiLanguage } from '../../i18n';
import { editorialDate } from '../../lib/dates';
import { postsForLanguage } from '../../lib/posts';

const all = await getCollection('blog');
// Both languages ship in the same document; CSS hides the inactive panel.
const panels: UiLanguage[] = ['en', 'th'];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>
					<span data-ui-language-copy="en" lang="en">All posts</span>
					<span data-ui-language-copy="th" lang="th">บทความทั้งหมด</span>
				</h1>
			</header>

			{
				panels.map((lang) => {
					const posts = postsForLanguage(all, lang);

					return (
						<div data-ui-language-panel={lang} lang={lang}>
							<ol class="post-list">
								{posts.map((post) => (
									<li class="post-row">
										<a href={`/blog/${post.id}/`}>
											<time class="date" datetime={post.data.pubDate.toISOString()}>
												{editorialDate(post.data.pubDate)}
											</time>
											<span class="body">
												{post.data.seriesOrder && (
													<span class="series-marker">
														{t(lang, 'series')} · {t(lang, 'episode')} {String(post.data.seriesOrder).padStart(2, '0')}
													</span>
												)}
												<span class="title">{post.data.title}</span>
												<span class="excerpt">{post.data.description}</span>
												<TagList tags={post.data.tags} variant="inline" />
											</span>
										</a>
									</li>
								))}
							</ol>
						</div>
					);
				})
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: var(--space-8);
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-row {
		margin: 0;
		border-top: 1px solid var(--border);
	}

	.post-row:last-child {
		border-bottom: 1px solid var(--border);
	}

	.post-row a {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-6);
		padding: var(--space-6) 0;
		color: inherit;
		text-decoration: none;
	}

	.date {
		color: var(--text-faint);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.body {
		display: block;
		max-width: var(--measure-prose);
	}

	.title {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--text);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.35;
		transition: color var(--duration) var(--ease);
	}

	.post-row a:hover .title {
		color: var(--accent);
	}

	.excerpt {
		display: block;
		margin-bottom: var(--space-2);
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.series-marker {
		display: block;
		margin-bottom: var(--space-1);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 500;
	}

	@media (max-width: 860px) {
		.post-row a {
			grid-template-columns: 1fr;
			gap: var(--space-1);
			padding: var(--space-4) 0;
		}
		.title {
			font-size: 1.1rem;
		}
	}
</style>
