---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import type { UiLanguage } from '../../i18n';
import { readingMinutes } from '../../lib/reading';
import { episodeNeighbors, postsForSeries, seriesInLanguage } from '../../lib/series';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const series = await getCollection('series');

	return posts.map((post) => {
		// Siblings sharing a translationKey are the same post in another language.
		const translations = Object.fromEntries(
			posts
				.filter((other) => other.data.translationKey && other.data.translationKey === post.data.translationKey)
				.map((other) => [other.data.lang, `/blog/${other.id}/`]),
		) as Partial<Record<UiLanguage, string>>;
		let seriesContext: SeriesContext | undefined;

		if (post.data.series && post.data.seriesOrder) {
			// Prefer the series entry in the post's own language, so a Thai post
			// links to the Thai series page and shows its Thai title.
			const entry = seriesInLanguage(series, post.data.series.id, post.data.lang);
			if (!entry) throw new Error(`Series "${post.data.series.id}" not found for post "${post.id}"`);

			const episodes = postsForSeries(posts, entry.id, post.data.lang);
			const { previous, next } = episodeNeighbors(episodes, post.id);
			seriesContext = {
				id: entry.id,
				title: entry.data.title,
				order: post.data.seriesOrder,
				total: episodes.length,
				previous: previous && { id: previous.id, title: previous.data.title },
				next: next && { id: next.id, title: next.data.title },
			};
		}

		return {
			params: { slug: post.id },
			props: { ...post, translations, seriesContext },
		};
	});
}

type SeriesContext = {
	id: string;
	title: string;
	order: number;
	total: number;
	previous?: { id: string; title: string };
	next?: { id: string; title: string };
};

type Props = CollectionEntry<'blog'> & {
	translations: Partial<Record<UiLanguage, string>>;
	seriesContext?: SeriesContext;
};

const { translations, seriesContext, ...post } = Astro.props;
const { Content } = await render(post as CollectionEntry<'blog'>);
const minutes = readingMinutes(post.body);
// The kicker follows the post's own tags; hardcoding "Benchmark" stopped being
// true the moment a post about deployment existed.
const kicker = (post.data.tags ?? []).slice(0, 2).join(' / ') || 'Engineering';
---

<BlogPost {...post.data} translations={translations} readingMinutes={minutes} kicker={kicker} seriesContext={seriesContext}>
	<Content />
</BlogPost>
