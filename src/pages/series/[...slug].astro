---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import type { UiLanguage } from '../../i18n';
import { readingMinutes } from '../../lib/reading';
import { postsForSeries, seriesTranslations, type SeriesPost } from '../../lib/series';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const series = await getCollection('series');

	// One page per language; the switcher navigates between them like blog posts.
	return series.map((entry) => ({
		params: { slug: entry.id },
		props: {
			entry,
			episodes: postsForSeries(allPosts, entry.id, entry.data.lang),
			translations: seriesTranslations(series, entry),
		},
	}));
}

type Props = {
	entry: CollectionEntry<'series'>;
	episodes: SeriesPost[];
	translations: Partial<Record<UiLanguage, string>>;
};

const { entry, episodes, translations } = Astro.props;
const { Content } = await render(entry);
const lang = entry.data.lang;
const copy =
	lang === 'th'
		? {
				kicker: 'บันทึกการเรียน',
				note: 'หมายเหตุ',
				episodes: 'บทความในซีรีส์',
				read: (minutes: number) => `อ่าน ${minutes} นาที`,
				empty: 'ตอนแรกกำลังอยู่ระหว่างการเขียน — กลับมาอ่านได้เร็ว ๆ นี้',
			}
		: {
				kicker: 'Learning journal',
				note: 'Note',
				episodes: 'Episodes in this series',
				read: (minutes: number) => `${minutes} min read`,
				empty: 'The first episode is being written — check back soon',
			};
---

<!doctype html>
<html lang={lang} data-translation-en={translations.en} data-translation-th={translations.th}>
	<head>
		<BaseHead title={entry.data.title} description={entry.data.description} lang={lang} translations={translations} />
	</head>
	<body>
		<Header />
		<main>
			<article class="series-intro">
				<header>
					<p class="kicker">{copy.kicker}</p>
					<h1>{entry.data.title}</h1>
					<p class="lead">{entry.data.description}</p>
				</header>

				<div class="prose">
					<Content />
				</div>

				{
					entry.data.disclaimer && (
						<aside class="disclaimer" aria-label={copy.note}>
							{entry.data.disclaimer}
						</aside>
					)
				}
			</article>

			<section class="episodes" aria-labelledby="episodes-heading">
				<h2 id="episodes-heading">{copy.episodes}</h2>
				{
					episodes.length ? (
						<ol>
							{episodes.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="episode-number" aria-hidden="true">
											{String(post.data.seriesOrder).padStart(2, '0')}
										</span>
										<span class="episode-body">
											<span class="episode-title">{post.data.title}</span>
											<span class="episode-description">{post.data.description}</span>
											<span class="meta">
												<FormattedDate date={post.data.pubDate} lang={post.data.lang} />
												<span aria-hidden="true"> · </span>
												{copy.read(readingMinutes(post.body))}
											</span>
										</span>
									</a>
								</li>
							))}
						</ol>
					) : (
						<p class="empty">{copy.empty}</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--measure-wide);
	}

	.series-intro,
	.episodes {
		max-width: var(--measure-prose);
	}

	.series-intro header {
		margin-bottom: var(--space-8);
	}

	h1 {
		max-width: 28ch;
	}

	.lead {
		max-width: 60ch;
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.prose {
		margin-bottom: var(--space-8);
	}

	.disclaimer {
		padding: var(--space-4) var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface-alt);
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.7;
	}

	.episodes {
		margin-top: var(--space-16);
	}

	.episodes h2 {
		margin-bottom: var(--space-6);
	}

	.episodes ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.episodes li {
		margin: 0;
		border-top: 1px solid var(--border);
	}

	.episodes li:last-child {
		border-bottom: 1px solid var(--border);
	}

	.episodes a {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-6) 0;
		color: inherit;
		text-decoration: none;
	}

	.episode-number {
		color: var(--text-faint);
		font-size: 1.25rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.episode-title,
	.episode-description {
		display: block;
	}

	.episode-title {
		margin-bottom: var(--space-2);
		color: var(--text);
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.45;
		transition: color var(--duration) var(--ease);
	}

	.episodes a:hover .episode-title {
		color: var(--accent);
	}

	.episode-description {
		margin-bottom: var(--space-2);
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.empty {
		padding: var(--space-8) 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		color: var(--text-muted);
	}

	@media (max-width: 560px) {
		.episodes a {
			grid-template-columns: 2.25rem minmax(0, 1fr);
		}
	}
</style>
