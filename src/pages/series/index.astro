---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import type { UiLanguage } from '../../i18n';
import { postsForSeries, seriesForLanguage } from '../../lib/series';

const allPosts = await getCollection('blog');
const allSeries = await getCollection('series');
// Both languages ship in the same document; CSS hides the inactive panel.
const panels: UiLanguage[] = ['en', 'th'];
const seriesByLanguage = (lang: UiLanguage) =>
	seriesForLanguage(allSeries, lang).map((entry) => ({
		entry,
		episodes: postsForSeries(allPosts, entry.id, entry.data.lang),
	}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Series | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>
					<span data-ui-language-copy="en" lang="en">Learning series</span>
					<span data-ui-language-copy="th" lang="th">ซีรีส์การเรียนรู้</span>
				</h1>
			</header>

			{
				panels.map((lang) => (
					<div data-ui-language-panel={lang} lang={lang}>
						<ol class="series-list">
							{seriesByLanguage(lang).map(({ entry, episodes }, index) => (
								<li lang={entry.data.lang}>
									<a href={`/series/${entry.id}/`}>
										<span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
										<span class="body">
											<span class="title">{entry.data.title}</span>
											<span class="description">{entry.data.description}</span>
											<span class="meta">
												{entry.data.lang === 'th'
													? `${episodes.length} ตอน`
													: `${episodes.length} ${episodes.length === 1 ? 'episode' : 'episodes'}`}
											</span>
										</span>
										<span class="arrow" aria-hidden="true">—</span>
									</a>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: var(--space-8);
	}

	.series-list {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.series-list li {
		margin: 0;
	}

	.series-list a {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition: border-color var(--duration) var(--ease);
	}

	.series-list a:hover {
		border-color: var(--accent);
	}

	.number {
		color: var(--text-faint);
		font-size: 1.25rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.title,
	.description,
	.meta {
		display: block;
	}

	.title {
		margin-bottom: var(--space-2);
		color: var(--text);
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.description {
		max-width: 65ch;
		margin-bottom: var(--space-3);
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.arrow {
		display: none;
	}

	@media (max-width: 860px) {
		.series-list a {
			grid-template-columns: 2rem minmax(0, 1fr);
			padding: var(--space-4);
		}
		.title {
			font-size: 1.15rem;
		}
	}
</style>
