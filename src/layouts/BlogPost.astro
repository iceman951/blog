---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import { SITE_TITLE } from '../consts';
import { t, type UiLanguage } from '../i18n';
import { isoDate } from '../lib/dates';

type Props = CollectionEntry<'blog'>['data'] & {
	/** Pathnames of this post in each language, when a translation exists. */
	translations?: Partial<Record<UiLanguage, string>>;
	/** Rounded reading time; omitted for pages that are not articles. */
	readingMinutes?: number;
	/** Small uppercase label above the title. */
	kicker?: string;
	/** Thai header copy for bilingual pages that switch language in place. */
	titleTh?: string;
	kickerTh?: string;
	/**
	 * The hero is a finished card with its own ground (like the About card), so it
	 * fills the frame instead of sitting padded on the white plate.
	 */
	heroBleed?: boolean;
	seriesContext?: {
		id: string;
		title: string;
		order: number;
		total: number;
		previous?: { id: string; title: string };
		next?: { id: string; title: string };
	};
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroBleed,
	ogImage,
	tags,
	lang = 'en',
	translations,
	readingMinutes,
	kicker,
	titleTh,
	kickerTh,
	seriesContext,
} = Astro.props;

// Link previews don't render SVG, so an SVG hero falls back to the site card.
const shareImage = ogImage ?? (heroImage?.format === 'svg' ? undefined : heroImage);
// An SVG hero is a chart drawn for the white plate; a raster hero is a finished card
// with its own ground, so it fills the frame unless a page says otherwise.
const isSvgHero = heroImage?.format === 'svg';
const bleed = heroBleed ?? (heroImage !== undefined && !isSvgHero);

const readLabel = lang === 'th' ? 'อ่าน ' + readingMinutes + ' นาที' : readingMinutes + ' min read';
// Benchmark posts are revised as numbers change; readers need to see which run
// they are reading (DESIGN.md §6). Same-day edits are not a revision.
const showUpdated = updatedDate && isoDate(updatedDate) !== isoDate(pubDate);
const isArticle = Boolean(readingMinutes);
---

<html lang={lang} data-translation-en={translations?.en} data-translation-th={translations?.th}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={shareImage}
			lang={lang}
			translations={translations}
		/>
		<slot name="head" />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					{
						seriesContext && (
							<p class="series-context">
								<a href={`/series/${seriesContext.id}/`}>{seriesContext.title}</a>
								<span aria-hidden="true">·</span>
								<span>{t(lang, 'episode')} {String(seriesContext.order).padStart(2, '0')} / {seriesContext.total}</span>
							</p>
						)
					}
					{
						kicker && (
							<p class="kicker">
								{kickerTh ? (
									<>
										<span data-ui-language-copy="en" lang="en">{kicker}</span>
										<span data-ui-language-copy="th" lang="th">{kickerTh}</span>
									</>
								) : (
									kicker
								)}
							</p>
						)
					}
					<h1>
						{titleTh ? (
							<>
								<span data-ui-language-copy="en" lang="en">{title}</span>
								<span data-ui-language-copy="th" lang="th">{titleTh}</span>
							</>
						) : (
							title
						)}
					</h1>
					{isArticle && <p class="lead">{description}</p>}
					<p class="meta line">
						{isArticle && <a class="byline" href="/about/" rel="author">{SITE_TITLE}</a>}
						{isArticle && <span class="dot" aria-hidden="true">·</span>}
						<FormattedDate date={pubDate} lang={lang} variant="editorial" />
						{
							showUpdated && (
								<>
									<span class="dot" aria-hidden="true">·</span>
									<span>
										{t(lang, 'updated')} <FormattedDate date={updatedDate} lang={lang} variant="editorial" />
									</span>
								</>
							)
						}
						{isArticle && <span class="dot" aria-hidden="true">·</span>}
						{isArticle && <span>{readLabel}</span>}
					</p>
					<TagList tags={tags} />
				</header>

				{
					heroImage && (
						<figure class:list={['hero-plate', { bleed }]}>
							<img
								src={heroImage.src}
								width={heroImage.width}
								height={heroImage.height}
								alt=""
								decoding="async"
								style={isSvgHero ? `max-width: ${heroImage.width}px` : undefined}
							/>
						</figure>
					)
				}

				<div class="prose">
					<slot />
				</div>

				{
					seriesContext && (seriesContext.previous || seriesContext.next) && (
						<nav class="episode-nav" aria-label={lang === 'th' ? 'บทความในซีรีส์' : 'Series episodes'}>
							{seriesContext.previous && (
								<a class="previous" href={`/blog/${seriesContext.previous.id}/`}>
									<span class="meta">← {t(lang, 'previousEpisode')}</span>
									<span>{seriesContext.previous.title}</span>
								</a>
							)}
							{seriesContext.next && (
								<a class="next" href={`/blog/${seriesContext.next.id}/`}>
									<span class="meta">{t(lang, 'nextEpisode')} →</span>
									<span>{seriesContext.next.title}</span>
								</a>
							)}
						</nav>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	// Shiki renders a bare <pre data-language>. Wrapping it here keeps the header
	// bar and copy control out of the content pipeline entirely.
	document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.parentNode?.insertBefore(wrapper, pre);

		const bar = document.createElement('div');
		bar.className = 'code-block__bar';

		const language = document.createElement('span');
		language.textContent = pre.dataset.language ?? 'code';

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-block__copy';
		button.setAttribute('aria-live', 'polite');
		button.textContent = 'Copy';
		button.addEventListener('click', async () => {
			try {
				// innerText excludes the CSS-generated line numbers, so what lands on
				// the clipboard is still runnable.
				await navigator.clipboard.writeText(pre.innerText);
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Press Ctrl+C';
			}
			window.setTimeout(() => (button.textContent = 'Copy'), 1600);
		});

		bar.append(language, button);
		wrapper.append(bar, pre);
	});
</script>

<style>
	main {
		width: var(--measure-wide);
	}
	.article-header {
		max-width: var(--measure-prose);
		margin-bottom: var(--space-12);
	}
	h1 {
		margin: 0 0 var(--space-4);
		max-width: 24ch;
	}
	:global(:lang(th)) h1 {
		max-width: 30ch;
	}
	.lead {
		margin: 0 0 var(--space-6);
		color: var(--text-muted);
		font-size: 1.1rem;
		line-height: 1.6;
	}
	:global(:lang(th)) .lead {
		line-height: 1.85;
	}
	.line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0 0 var(--space-4);
	}
	.byline {
		color: var(--text-muted);
		font-weight: 500;
		text-decoration: none;
	}
	.byline:hover {
		color: var(--accent);
	}
	.series-context {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45em;
		margin: 0 0 var(--space-3);
		color: var(--text-muted);
		font-size: 0.82rem;
	}
	.series-context a {
		font-weight: 500;
		text-decoration: none;
	}
	/*
	  Hero images are files shown through <img>: an SVG there sees the OS colour
	  scheme but never the site's theme toggle, so it is drawn for, and sits on, a
	  white plate in both themes (DESIGN.md §6).
	*/
	.hero-plate {
		margin: 0 0 var(--space-12);
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: #ffffff;
	}
	.hero-plate.bleed {
		padding: 0;
		overflow: hidden;
		background: transparent;
	}
	/* An SVG chart shows at no more than its drawn size, so its type stays at the sizes it was set in. */
	.hero-plate img {
		margin-inline: auto;
	}
	.hero-plate img {
		display: block;
		width: 100%;
		height: auto;
	}
	.prose {
		max-width: var(--measure-prose);
	}
	.prose :global(h2) {
		margin-top: var(--space-12);
	}
	.prose :global(h3) {
		margin-top: var(--space-8);
	}
	/* Wide objects break out of the reading measure but never past the frame. */
	.prose :global(table),
	.prose :global(.scroll-table),
	.prose :global(figure.chart),
	.prose :global(.code-block) {
		width: min(var(--measure-wide), calc(100vw - 2 * var(--gutter)));
	}
	.episode-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
		max-width: var(--measure-prose);
		margin-top: var(--space-16);
	}
	.episode-nav a {
		display: flex;
		min-height: 44px;
		flex-direction: column;
		justify-content: center;
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.45;
		text-decoration: none;
		transition: border-color var(--duration) var(--ease);
	}
	.episode-nav a:hover {
		border-color: var(--accent);
	}
	.episode-nav .meta {
		display: block;
		margin-bottom: var(--space-1);
		font-weight: 400;
	}
	.episode-nav .next {
		grid-column: 2;
		text-align: right;
	}

	@media (max-width: 860px) {
		.hero-plate {
			margin-bottom: var(--space-8);
			padding: var(--space-2);
		}
		.article-header {
			margin-bottom: var(--space-8);
		}
		.episode-nav {
			grid-template-columns: 1fr;
		}
		.episode-nav .next {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
